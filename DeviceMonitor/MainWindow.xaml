<!--
    阅读入口：后台创建 MainViewModel 并设为 DataContext。
    导航 Pages → CurrentPage → ContentControl → 对应 DataTemplate/页面；页面沿用这个页面对象作数据源。
    历史页的报警标签例外：明确把 Alarms 子对象交给 AlarmHistoryView。
-->
<Window x:Class="DeviceMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeviceMonitor.ViewModels"
        xmlns:views="clr-namespace:DeviceMonitor.Views"
        Title="{Binding WindowTitle}"
        Width="1200"
        Height="780"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="14"
        Foreground="{StaticResource PrimaryTextBrush}">

    <Window.Resources>
        <!-- 监控页面的数据对象，用监控界面来显示，跟ContentControl控件搭配，当选择数据对象，就会映射对应的界面文件到右侧 -->
        <DataTemplate DataType="{x:Type vm:MonitoringViewModel}">
            <views:MonitoringView />
        </DataTemplate>

        <!-- 设备管理的数据对象，用设备管理界面来显示 -->
        <DataTemplate DataType="{x:Type vm:DeviceManagementViewModel}">
            <views:DeviceManagementView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:UserManagementViewModel}">
            <views:UserManagementView />
        </DataTemplate>

        <!-- 采集管理的数据对象，使用 AcquisitionView 展示。 -->
        <DataTemplate DataType="{x:Type vm:AcquisitionViewModel}">
            <views:AcquisitionView />
        </DataTemplate>

        <!-- 导航选中 HistoryViewModel 后，用历史页面展示它，并把这个对象交给页面作为 DataContext。 -->
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <!-- 共用一个历史入口，两个标签各用自己的数据源，不增加新的左侧导航。 -->
            <TabControl>
                <TabItem Header="采集数据">
                    <views:HistoryView />
                </TabItem>
                <TabItem Header="报警历史">
                    <views:AlarmHistoryView DataContext="{Binding Alarms}" />
                </TabItem>
            </TabControl>
        </DataTemplate>
        
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="184" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 顶部标题 -->
        <Border Grid.ColumnSpan="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushNeutral}"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 用简单线条画标记，不加载图片或引入图标库。 -->
                    <Border Width="36" Height="36" CornerRadius="9" Margin="0,0,12,0"
                            Background="{StaticResource AccentBrush}">
                        <Path Data="M 0,10 L 5,10 8,2 13,18 17,8 23,8" Stroke="White"
                              StrokeThickness="1.8" Stretch="Uniform" Margin="7" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding WindowTitle}"
                               FontSize="19"
                               FontWeight="SemiBold" />
                    <TextBlock Text="设备与账户工作台"
                               Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AccountMenuButton" Padding="12,7" Click="AccountMenuButton_Click"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            ToolTip="点击修改密码或查看运行日志"
                            Background="{StaticResource SoftSurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrushNeutral}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <Button.ContextMenu>
                            <!-- 菜单不在页面的数据源继承链中，明确取打开它的按钮的数据源。 -->
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="修改密码" Command="{Binding ChangePasswordCommand}" />
                                <MenuItem Header="打开日志文件夹" Command="{Binding OpenLogsCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentUser.UserName}"
                                       FontWeight="SemiBold" MaxWidth="160"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CurrentUser.UserName}" />
                            <TextBlock Text="  ·  "
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding CurrentUserRoleName}"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Text="  ▾" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Button>
                    <!-- 命令通知 ViewModel；窗口后台收到事件后才弹确认框、停止任务、切回登录。 -->
                    <Button Content="退出登录"
                            Command="{Binding LogoutCommand}"
                            Margin="12,0,0,0"
                            Padding="12,7"
                            MinWidth="88"
                            Style="{StaticResource SecondaryActionButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 左侧导航 -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushNeutral}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="工作空间" Margin="22,22,0,8" FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            <!--列表中的数据来源于Pages属性，存的是各页面的viewmodel对象，选中就会把对象传到CurrentPage，跟下面的ContentControl控件联系-->
            <ListBox Grid.Row="1" Margin="10,0,10,14"
                     BorderThickness="0"
                     Background="Transparent"
                     ItemsSource="{Binding Pages}"
                     SelectedItem="{Binding CurrentPage, Mode=TwoWay}"
                     SelectionMode="Single"
                     HorizontalContentAlignment="Stretch">

                <!-- 小标记只帮助分辨页面。数据源仍然是原来的各个 ViewModel。 -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="27" Height="27" CornerRadius="6" Margin="0,0,10,0"
                                    Background="#EBEFF2" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Text" Value="页" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Title}" Value="实时监控"><Setter Property="Text" Value="监" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Title}" Value="设备管理"><Setter Property="Text" Value="设" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Title}" Value="采集点配置"><Setter Property="Text" Value="点" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Title}" Value="历史记录"><Setter Property="Text" Value="历" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Title}" Value="用户管理"><Setter Property="Text" Value="用" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,10" />
                        <Setter Property="Margin" Value="0,0,0,5" />
                        <Setter Property="FontSize" Value="15" />
                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Content"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder"
                                                    Property="Background"
                                                    Value="{StaticResource SoftSurfaceBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#E7ECF1" />
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#D7DFE6" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#A2AAB2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            </Grid>
        </Border>

        <!-- 右侧显示当前页面 -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="16"
                Padding="18"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushNeutral}"
                BorderThickness="1"
                CornerRadius="12">
            <!-- Content就是当前选择页面的ViewModel对象，由顶端的DataTemplate控件决定用CurrentPage指定的对象的对应界面展示，并且每个界面绑定的数据源就是对应的CurrentPage存的对象 -->
            <ContentControl Content="{Binding CurrentPage}" 
                HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Border>
    </Grid>
</Window>
