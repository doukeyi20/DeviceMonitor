<Window x:Class="DeviceMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeviceMonitor.ViewModels"
        xmlns:views="clr-namespace:DeviceMonitor.Views"
        Title="{Binding WindowTitle}"
        Width="1200"
        Height="780"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="14"
        Foreground="{StaticResource PrimaryTextBrush}">

    <Window.Resources>
        <!-- 监控页面的数据对象，用监控界面来显示，跟ContentControl搭配 -->
        <DataTemplate DataType="{x:Type vm:MonitoringViewModel}">
            <views:MonitoringView />
        </DataTemplate>

        <!-- 设备管理的数据对象，用设备管理界面来显示 -->
        <DataTemplate DataType="{x:Type vm:DeviceManagementViewModel}">
            <views:DeviceManagementView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:UserManagementViewModel}">
            <views:UserManagementView />
        </DataTemplate>
        
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 顶部标题 -->
        <Border Grid.ColumnSpan="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushNeutral}"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WindowTitle}"
                               FontSize="19"
                               FontWeight="SemiBold" />
                    <TextBlock Text="设备与账户工作台"
                               Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="12,7"
                        Background="{StaticResource SoftSurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushNeutral}"
                        BorderThickness="1"
                        CornerRadius="16"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CurrentUser.UserName}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="  ·  "
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding CurrentUserRoleName}"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 左侧导航 -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushNeutral}"
                BorderThickness="0,0,1,0">

            <ListBox Margin="12,22"
                     BorderThickness="0"
                     Background="Transparent"
                     ItemsSource="{Binding Pages}"
                     SelectedItem="{Binding CurrentPage, Mode=TwoWay}"
                     DisplayMemberPath="Title"
                     SelectionMode="Single"
                     HorizontalContentAlignment="Stretch">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="16,12" />
                        <Setter Property="Margin" Value="0,0,0,5" />
                        <Setter Property="FontSize" Value="15" />
                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Content"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder"
                                                    Property="Background"
                                                    Value="{StaticResource SoftSurfaceBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#EAEDF0" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#A2AAB2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- 右侧显示当前页面 -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="24"
                Padding="28"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushNeutral}"
                BorderThickness="1"
                CornerRadius="12">
            <!-- Content绑定当前页面的ViewModel对象，由DataTemplate决定用CurrentPage指定的对象的对应界面展示，并且每个界面绑定的数据源就是对应的CurrentPage存的对象 -->
            <ContentControl Content="{Binding CurrentPage}" 
                HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Border>
    </Grid>
</Window>
