<Window x:Class="DeviceMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeviceMonitor.ViewModels"
        xmlns:views="clr-namespace:DeviceMonitor.Views"
        Title="{Binding WindowTitle}"
        Width="1200"
        Height="780"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Window.Resources>
        <!-- 监控页面的数据对象，用监控界面来显示，跟ContentControl搭配 -->
        <DataTemplate DataType="{x:Type vm:MonitoringViewModel}">
            <views:MonitoringView />
        </DataTemplate>

        <!-- 设备管理的数据对象，用设备管理界面来显示 -->
        <DataTemplate DataType="{x:Type vm:DeviceManagementViewModel}">
            <views:DeviceManagementView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 顶部标题 -->
        <Border Grid.ColumnSpan="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">
            <TextBlock Margin="24,0"
                       Text="{Binding WindowTitle}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Border>

        <!-- 左侧导航 -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">

            <ListBox Margin="12,20"
                     BorderThickness="0"
                     Background="Transparent"
                     ItemsSource="{Binding Pages}"
                     SelectedItem="{Binding CurrentPage, Mode=TwoWay}"
                     DisplayMemberPath="Title"
                     SelectionMode="Single"
                     HorizontalContentAlignment="Stretch">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="16,12" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="FontSize" Value="16" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- 右侧显示当前页面 -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="24"
                Padding="24"
                Background="White"
                CornerRadius="8">
            <!-- Content绑定当前页面的ViewModel对象，由DataTemplate决定用CurrentPage指定的对象的对应界面展示 -->
            <ContentControl Content="{Binding CurrentPage}" 
                HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Border>
    </Grid>
</Window>
