<!--
    数据源是后台创建的 MainViewModel；左侧选择页面，右侧显示对应界面。
-->
<Window x:Class="DeviceMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeviceMonitor.ViewModels"
        xmlns:views="clr-namespace:DeviceMonitor.Views"
        Title="{Binding WindowTitle}"
        Icon="{StaticResource ApplicationIcon}"
        Width="1440"
        Height="900"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="14"
        Foreground="{StaticResource PrimaryTextBrush}">

    <Window.Resources>
        <!-- CurrentPage 是 MonitoringViewModel 时，右侧用 MonitoringView 显示它。 -->
        <DataTemplate DataType="{x:Type vm:MonitoringViewModel}">
            <views:MonitoringView />
        </DataTemplate>

        <!-- 设备管理数据用 DeviceManagementView 显示。 -->
        <DataTemplate DataType="{x:Type vm:DeviceManagementViewModel}">
            <views:DeviceManagementView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:UserManagementViewModel}">
            <views:UserManagementView />
        </DataTemplate>

        <!-- 采集点配置数据用 AcquisitionView 显示。 -->
        <DataTemplate DataType="{x:Type vm:AcquisitionViewModel}">
            <views:AcquisitionView />
        </DataTemplate>

        <!-- 历史数据用下面的两个标签显示，各自有自己的数据源。 -->
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <!-- 读数标签用 HistoryViewModel；报警标签用它的 Alarms 属性。 -->
            <TabControl>
                <TabItem Header="采集数据">
                    <views:HistoryView />
                </TabItem>
                <TabItem Header="报警历史">
                    <views:AlarmHistoryView DataContext="{Binding Alarms}" />
                </TabItem>
            </TabControl>
        </DataTemplate>
        
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="184" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 顶部标题 -->
        <Border Grid.ColumnSpan="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushNeutral}"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 用线条画应用标记。 -->
                    <Border Width="36" Height="36" CornerRadius="9" Margin="0,0,12,0"
                            Background="{StaticResource AccentBrush}">
                        <Path Data="M 0,10 L 5,10 8,2 13,18 17,8 23,8" Stroke="White"
                              StrokeThickness="1.8" Stretch="Uniform" Margin="7" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding WindowTitle}"
                               FontSize="19"
                               FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AccountMenuButton" Padding="12,7" Click="AccountMenuButton_Click"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            ToolTip="点击修改密码或查看运行日志"
                            Background="{StaticResource SoftSurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrushNeutral}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <Button.ContextMenu>
                            <!-- 菜单不会自动拿到页面的数据源，这里明确从所属按钮取。 -->
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="修改密码" Command="{Binding ChangePasswordCommand}" />
                                <MenuItem Header="打开日志文件夹" Command="{Binding OpenLogsCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentUser.UserName}"
                                       FontWeight="SemiBold" MaxWidth="160"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CurrentUser.UserName}" />
                            <TextBlock Text="  ·  "
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding CurrentUserRoleName}"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Text="  ▾" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 左侧导航 -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushNeutral}"
                BorderThickness="0,0,1,0">
            <Grid x:Name="WorkspaceNavigation">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="工作空间" Margin="22,22,0,8" FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            <!-- Pages 存各页面的 ViewModel；选中的对象写入 CurrentPage，供右侧显示。 -->
            <ListBox Grid.Row="1" Margin="10,0,10,14"
                     BorderThickness="0"
                     Background="Transparent"
                     ItemsSource="{Binding Pages}"
                     SelectedItem="{Binding CurrentPage, Mode=TwoWay}"
                     SelectionMode="Single"
                     HorizontalContentAlignment="Stretch">

                <!-- 每个页面的导航小标记。 -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="27" Height="27" CornerRadius="6" Margin="0,0,10,0"
                                    Background="#EBEFF2" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Text" Value="页" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Title}" Value="实时监控"><Setter Property="Text" Value="监" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Title}" Value="设备管理"><Setter Property="Text" Value="设" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Title}" Value="采集点配置"><Setter Property="Text" Value="点" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Title}" Value="历史记录"><Setter Property="Text" Value="历" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Title}" Value="用户管理"><Setter Property="Text" Value="用" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,10" />
                        <Setter Property="Margin" Value="0,0,0,5" />
                        <Setter Property="FontSize" Value="15" />
                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Content"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder"
                                                    Property="Background"
                                                    Value="{StaticResource SoftSurfaceBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#E7ECF1" />
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#D7DFE6" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#A2AAB2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
                <!-- 固定在工作空间底部；原命令仍负责确认、停止任务和返回登录。 -->
                <Border x:Name="WorkspaceFooter" Grid.Row="2" Margin="10,0,10,14" Padding="0,12,0,0"
                        BorderBrush="{StaticResource BorderBrushNeutral}" BorderThickness="0,1,0,0">
                    <Button x:Name="LogoutButton" Content="退出登录" Command="{Binding LogoutCommand}"
                            HorizontalContentAlignment="Left" Padding="12,9" MinHeight="40"
                            Foreground="#B42318" Style="{StaticResource SecondaryActionButtonStyle}" />
                </Border>
            </Grid>
        </Border>

        <!-- 右侧显示当前页面 -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="16"
                Padding="18"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushNeutral}"
                BorderThickness="1"
                CornerRadius="12">
            <!-- Content 取 CurrentPage；上面的 DataTemplate 决定用哪个界面，并把该对象交给它作数据源。 -->
            <ContentControl Content="{Binding CurrentPage}" 
                HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Border>
    </Grid>
</Window>
