

<!-- 报警历史：筛选条件、分页结果及导出操作。 -->
<UserControl x:Class="DeviceMonitor.View.AlarmHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="AlarmHistoryView_Loaded" Unloaded="AlarmHistoryView_Unloaded"
             Language="zh-CN" FontFamily="Microsoft YaHei UI" Foreground="{StaticResource PrimaryTextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="8"
                Style="{StaticResource ToolbarCardStyle}">
            <Grid>

                <Expander x:Name="FilterExpander" IsExpanded="True" IsEnabled="{Binding CanEditFilters}">
                    <Expander.Header>
                        <TextBlock Text="筛选条件" Margin="0,3,205,3"
                                   Style="{StaticResource SectionHeadingStyle}"
                                   ToolTip="按设备、报警类别和发生时间筛选。折叠不会重置条件。" />
                    </Expander.Header>

                    <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,6,4,0">
                            <WrapPanel>
                                <StackPanel Width="210" Margin="0,0,14,8">
                                    <TextBlock Text="设备" Margin="0,0,0,5" />
                                    <ComboBox ItemsSource="{Binding DeviceOptions}" DisplayMemberPath="DisplayName"
                                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" MinHeight="32"
                                              ToolTip="来自报警历史；已删除的设备也能查询以前的报警。" />
                                </StackPanel>
                                <StackPanel Width="180" Margin="0,0,0,8">
                                    <TextBlock Text="类别" Margin="0,0,0,5" />
                                    <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="DisplayName"
                                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" MinHeight="32" />
                                </StackPanel>
                                <CheckBox Content="按发生时间筛选" IsChecked="{Binding UseTimeFilter}"
                                          Margin="14,23,0,8" VerticalAlignment="Center"
                                          ToolTip="使用本机时间；不勾选则查询全部发生时间。" />
                            </WrapPanel>

                            <WrapPanel Margin="0,4,0,0">
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UseTimeFilter}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,8">
                                    <TextBlock Text="开始" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" Width="135" MinHeight="32" />
                                    <TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}"
                                             Width="86" Margin="6,0,0,0" MaxLength="8" ToolTip="HH:mm:ss，例如 08:30:00" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="结束" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" Width="135" MinHeight="32" />
                                    <TextBox Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}"
                                             Width="86" Margin="6,0,0,0" MaxLength="8" ToolTip="HH:mm:ss；包含结束这一秒内的全部记录。" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Expander>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="{Binding RefreshButtonText}" Command="{Binding RefreshRecordsCommand}"
                            Height="32" Width="105" Padding="8,4" Margin="0,0,8,0" Style="{StaticResource PrimaryActionButtonStyle}" />
                    <Button Content="重置条件" Command="{Binding ResetFiltersCommand}"
                            Height="32" Width="86" Padding="8,4" Style="{StaticResource SecondaryActionButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,12,0,8" Padding="0,0,0,8" BorderThickness="0,0,0,1" CornerRadius="0"
                Style="{StaticResource SectionCardStyle}">
            <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,10,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="查询结果" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding RecordSummary}" Style="{StaticResource SubtleTextStyle}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding RecordSummary}" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="导出全部结果" Command="{Binding ExportRecordsCommand}"
                        ToolTip="导出全部匹配页，不含查询后新增的报警；每条报警状态以实际导出读取时为准。"
                        Height="32" Padding="10,4" Style="{StaticResource SecondaryActionButtonStyle}" />
                <Button Content="取消导出" Command="{Binding ExportRecordsCancelCommand}"
                        Height="32" Padding="10,4" Margin="8,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExporting}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="0" Style="{StaticResource SectionCardStyle}">
            <Grid MinHeight="70">

            <!-- 列表只展示识别报警的关键信息；选中行可展开全部细节，不影响导出内容。 -->
            <DataGrid x:Name="AlarmRecordsGrid" BorderThickness="0" RowHeight="38" ColumnHeaderHeight="36"
                          ItemsSource="{Binding Records}" AutoGenerateColumns="False" IsReadOnly="True"
                          RowDetailsVisibilityMode="VisibleWhenSelected" AreRowDetailsFrozen="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                          CanUserResizeColumns="False" HeadersVisibility="Column"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                    <DataGridTemplateColumn Header="状态" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="7,3" Margin="10,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        ToolTip="未恢复表示这条历史报警没有恢复时间，不代表设备当前仍在采集。">
                                    <Border.Style><Style TargetType="Border">
                                        <Setter Property="Background" Value="#F1F5F9" />
                                        <Style.Triggers><DataTrigger Binding="{Binding StateText}" Value="未恢复"><Setter Property="Background" Value="#FFF1F0" /></DataTrigger></Style.Triggers>
                                    </Style></Border.Style>
                                    <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style><Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                            <Style.Triggers><DataTrigger Binding="{Binding StateText}" Value="未恢复"><Setter Property="Foreground" Value="#B42318" /></DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="设备" Binding="{Binding DeviceName}" Width="1.1*" MinWidth="110" ElementStyle="{StaticResource TableCellTextStyle}" />
                    <DataGridTextColumn Header="采集点" Binding="{Binding PointName}" Width="1.2*" MinWidth="110" ElementStyle="{StaticResource TableCellTextStyle}" />
                    <DataGridTextColumn Header="原因" Binding="{Binding KindText}" Width="110" ElementStyle="{StaticResource TableCellTextStyle}" />
                    <DataGridTextColumn Header="异常值" Binding="{Binding ValueText}" Width="100" ElementStyle="{StaticResource TableNumberTextStyle}" HeaderStyle="{StaticResource TableNumberHeaderStyle}" />
                    <DataGridTextColumn Header="发生时间（本机）"
                                            Binding="{Binding StartedAtLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                            Width="172" ElementStyle="{StaticResource TableTimeTextStyle}" />
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Margin="12,0,12,12" Padding="14,10" Background="{StaticResource SoftSurfaceBrush}" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding PointName}" Margin="0,3,0,8" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                                <UniformGrid Columns="2">
                                    <TextBlock Margin="0,0,12,6"><Run Text="类别：" /><Run Text="{Binding CategoryText, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Margin="0,0,0,6"><Run Text="出现次数：" /><Run Text="{Binding Occurrences, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Margin="0,0,12,6"><Run Text="界限：" /><Run Text="{Binding LimitText, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Margin="0,0,0,6" ToolTip="最近一次越限时的值，不是当前实时值。"><Run Text="异常值：" /><Run Text="{Binding ValueText, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Margin="0,0,12,6"><Run Text="最近发生：" /><Run Text="{Binding LastSeenAtLocal, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" /></TextBlock>
                                    <TextBlock Margin="0,0,0,6"><Run Text="结束时间：" /><Run Text="{Binding EndedAtLocal, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}, TargetNullValue=—}" /></TextBlock>
                                </UniformGrid>
                                <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
                </DataGrid>
            <Border Padding="12" Margin="12,40,12,8" MaxWidth="360" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Background="{StaticResource SoftSurfaceBrush}" CornerRadius="8" IsHitTestVisible="False">
                <Border.Style><Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding ShowEmptyMessage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <StackPanel>
                    <TextBlock Text="没有匹配的报警记录" FontWeight="SemiBold" TextAlignment="Center" />
                </StackPanel>
            </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,8,0,0" Padding="0,2" Background="Transparent"
                Style="{StaticResource ToolbarCardStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="上一页" Command="{Binding PreviousPageCommand}" Height="28" Padding="10,3" Margin="0,0,10,0" Style="{StaticResource SecondaryActionButtonStyle}" />
            <TextBlock Text="{Binding PageDescription}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button Content="下一页" Command="{Binding NextPageCommand}" Height="28" Padding="10,3" Style="{StaticResource SecondaryActionButtonStyle}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,4,0,0">
            <TextBlock Style="{StaticResource StatusMessageTextStyle}" Text="{Binding PageMessage}" ToolTip="{Binding PageMessage}" TextTrimming="CharacterEllipsis"
                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
        </Grid>
    </Grid>
</UserControl>
