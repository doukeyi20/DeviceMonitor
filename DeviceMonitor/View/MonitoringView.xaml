<!-- 切换设备只改变显示；启停按钮操作当前设备。 -->
<UserControl
    x:Class="DeviceMonitor.View.MonitoringView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="clr-namespace:DeviceMonitor.Model"
    xmlns:view="clr-namespace:DeviceMonitor.View"
    Loaded="MonitoringView_Loaded"
    SizeChanged="LayoutChanged">
    <UserControl.Resources>
        <Style
            x:Key="CardItem"
            TargetType="ListBoxItem">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeutral}" />
            <Setter
                Property="Padding"
                Value="0" />
            <Setter
                Property="Margin"
                Value="0,0,8,8" />
            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch" />
            <Setter
                Property="Template">
                <Setter.Value>
                    <ControlTemplate
                        TargetType="ListBoxItem">
                        <Border
                            x:Name="Card"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="IsMouseOver"
                                Value="True">
                                <Setter
                                    TargetName="Card"
                                    Property="Background"
                                    Value="{StaticResource SoftSurfaceBrush}" />
                            </Trigger>
                            <Trigger
                                Property="IsSelected"
                                Value="True">
                                <Setter
                                    TargetName="Card"
                                    Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}" />
                                <Setter
                                    TargetName="Card"
                                    Property="Background"
                                    Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 设备是导航卡，不使用表头和行列；色条只表示当前查看对象。 -->
        <Style x:Key="DeviceNavigationCard" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="DeviceCard" Background="{StaticResource SoftSurfaceBrush}"
                                BorderBrush="Transparent" BorderThickness="3,0,0,0" CornerRadius="8" Padding="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DeviceCard" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DeviceCard" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="DeviceCard" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate
            x:Key="AlarmItem">
            <Button
                Command="{Binding DataContext.LocateAlarmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                HorizontalContentAlignment="Stretch"
                Style="{StaticResource LinkActionButtonStyle}"
                Height="Auto"
                Padding="0"
                Margin="0,0,0,8"
                ToolTip="{Binding Message}"
                Foreground="{StaticResource PrimaryTextBrush}">
                <Border
                    Padding="10"
                    CornerRadius="6">
                    <Border.Style>
                        <Style
                            TargetType="Border">
                            <Setter
                                Property="Background"
                                Value="{StaticResource SoftSurfaceBrush}" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding State}"
                                    Value="{x:Static model:AlarmState.Active}">
                                    <Setter
                                        Property="Background"
                                        Value="#FFF1F0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock
                            Text="{Binding DeviceName}"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,4,0,0"
                            TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style
                                    TargetType="TextBlock">
                                    <Setter
                                        Property="Foreground"
                                        Value="{StaticResource SecondaryTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding State}"
                                            Value="{x:Static model:AlarmState.Active}">
                                            <Setter
                                                Property="Foreground"
                                                Value="#B42318" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run
                                Text="{Binding PointName, Mode=OneWay}" />
                            <Run
                                Text=" · " />
                            <Run
                                Text="{Binding KindText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource SubtleTextStyle}"
                            FontSize="11">
                            <Run
                                Text="{Binding StartedAtLocal, StringFormat=HH:mm:ss, Mode=OneWay}" />
                            <Run
                                Text=" · " />
                            <Run
                                Text="{Binding StateText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="210" />
            <ColumnDefinition
                Width="16" />
            <ColumnDefinition
                Width="*" />
        </Grid.ColumnDefinitions>
        <Border
            Style="{StaticResource SectionCardStyle}"
            Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                    <RowDefinition
                        Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel
                    Margin="2,0,0,12">
                    <Button
                        DockPanel.Dock="Right"
                        Content="刷新"
                        Command="{Binding RefreshDevicesCommand}"
                        Style="{StaticResource LinkActionButtonStyle}"
                        Padding="8,4" />
                    <TextBlock
                        Text="设备"
                        Style="{StaticResource SectionHeadingStyle}"
                        VerticalAlignment="Center" />
                </DockPanel>
                <ListBox
                    x:Name="MonitorDevices"
                    Grid.Row="1"
                    ItemsSource="{Binding Devices}"
                    SelectedItem="{Binding SelectedDevice}"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ItemContainerStyle="{StaticResource DeviceNavigationCard}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Border DockPanel.Dock="Left" Background="{StaticResource SurfaceBrush}"
                                            CornerRadius="7" Width="36" Height="36" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding ConnectionType}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Device.Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding DeviceAddress}" FontSize="11" Margin="0,0,0,10"
                                           Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConnectionDetails}" />
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource SecondaryTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Sampling.IsRunning}" Value="True"><Setter Property="Fill" Value="#3F7B65" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding HasReadFailure}" Value="True"><Setter Property="Fill" Value="#B42318" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding SamplingStateText}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel
                    Grid.Row="2"
                    Margin="2,10,2,0">
                    <TextBlock
                        Style="{StaticResource SubtleTextStyle}"
                        Margin="0,0,0,8">
                        <Run
                            Text="{Binding ActiveSamplingCount, Mode=OneWay}" />
                        <Run
                            Text=" 台正在采集" />
                    </TextBlock>
                    <Button
                        Content="停止全部采集"
                        Command="{Binding StopAllSamplingCommand}"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Height="34" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid
            Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="*"
                    MinHeight="250" />
                <RowDefinition
                    Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                x:Name="DeviceHeader"
                Style="{StaticResource SectionCardStyle}"
                Padding="16"
                Margin="0,0,0,12">
                <DockPanel>
                    <StackPanel
                        DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <Button
                            Content="开始采集"
                            Command="{Binding StartSamplingCommand}"
                            Height="38"
                            Margin="12,0,8,0"
                            Style="{StaticResource PrimaryActionButtonStyle}" />
                        <Button
                            Content="停止"
                            Command="{Binding StopSamplingCommand}"
                            Height="38"
                            Style="{StaticResource SecondaryActionButtonStyle}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock
                            Text="{Binding DeviceTitle}"
                            FontSize="19"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="{Binding DeviceDetails}"
                            Margin="0,6,0,0"
                            TextWrapping="Wrap"
                            Style="{StaticResource SubtleTextStyle}" />
                        <TextBlock
                            Text="{Binding SelectedDevice.Sampling.HistoryErrorText}"
                            Foreground="#B45309"
                            TextWrapping="Wrap"
                            FontSize="11"
                            Margin="0,4,0,0" />
                        <TextBlock
                            Text="{Binding SelectedDevice.DataAgeText}"
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- 多点位在卡片区域内滚动，不挤压曲线；选卡片即切换曲线。 -->
            <ListBox
                x:Name="ReadingCards"
                Grid.Row="1"
                ItemsSource="{Binding Readings}"
                SelectedItem="{Binding SelectedReading}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                MaxHeight="256"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionChanged="RevealSelectedItem">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardItem}">
                        <Setter Property="Height" Value="120" />
                        <Setter Property="Background" Value="{StaticResource SoftSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ReadingColumns}" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel
                            ToolTip="{Binding DetailsText}">
                            <TextBlock
                                Text="{Binding PointName}"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel
                                Orientation="Horizontal"
                                Margin="0,6,0,7">
                                <TextBlock
                                    Text="{Binding NumberText}"
                                    FontSize="34"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{Binding Point.Unit}"
                                    Margin="7,0,0,5"
                                    VerticalAlignment="Bottom"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <DockPanel>
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Text="{Binding ReadTimeText}"
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock
                                    Text="{Binding StatusText}"
                                    FontSize="12"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style
                                            TargetType="TextBlock">
                                            <Setter
                                                Property="Foreground"
                                                Value="{StaticResource SecondaryTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsAlert}"
                                                    Value="True">
                                                    <Setter
                                                        Property="Foreground"
                                                        Value="#B42318" />
                                                    <Setter
                                                        Property="FontWeight"
                                                        Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border
                Grid.Row="2"
                Padding="18"
                Margin="0,0,0,12">
                <Border.Style>
                    <Style
                        TargetType="Border"
                        BasedOn="{StaticResource ToolbarCardStyle}">
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding HasReadings}"
                                Value="True">
                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    Text="开始采集后显示点位读数；选中卡片查看对应曲线。"
                    Style="{StaticResource SubtleTextStyle}" />
            </Border>
            <Grid
                Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="7*" />
                    <ColumnDefinition
                        Width="12" />
                    <ColumnDefinition
                        Width="3*"
                        MinWidth="220" />
                </Grid.ColumnDefinitions>
                <Border
                    Style="{StaticResource SectionCardStyle}"
                    Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="Auto" />
                            <RowDefinition
                                Height="*" />
                            <RowDefinition
                                Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel
                            Margin="0,0,0,10">
                            <TextBlock
                                DockPanel.Dock="Right"
                                Text="最近 5 分钟"
                                Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock
                                Text="{Binding Trend.AxisTitle}"
                                Style="{StaticResource SectionHeadingStyle}" />
                        </DockPanel>
                        <view:TrendChart
                            Grid.Row="1"
                            Samples="{Binding Trend.Samples}"
                            AxisTitle="{Binding Trend.AxisTitle}"
                            WindowDuration="{Binding Trend.WindowDuration}" />
                        <TextBlock
                            Grid.Row="2"
                            Text="{Binding Trend.StatusText}"
                            Style="{StaticResource StatusMessageTextStyle}"
                            Margin="0,7,0,0" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="2"
                    Style="{StaticResource SectionCardStyle}"
                    Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="*" />
                            <RowDefinition
                                Height="Auto" />
                        </Grid.RowDefinitions>
                        <TabControl
                            Background="Transparent"
                            BorderThickness="0">
                            <TabItem
                                Header="当前报警">
                                <Grid
                                    Margin="0,8,0,0">
                                    <ScrollViewer
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl
                                            ItemsSource="{Binding Alarms.ActiveRecords}"
                                            ItemTemplate="{StaticResource AlarmItem}" />
                                    </ScrollViewer>
                                    <TextBlock
                                        Text="当前无报警"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style
                                                TargetType="TextBlock"
                                                BasedOn="{StaticResource SubtleTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding Alarms.HasActiveAlarms}"
                                                        Value="True">
                                                        <Setter
                                                            Property="Visibility"
                                                            Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </TabItem>
                            <TabItem
                                Header="最近事件">
                                <ScrollViewer
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled"
                                    Margin="0,8,0,0">
                                    <ItemsControl
                                        ItemsSource="{Binding Alarms.Records}"
                                        ItemTemplate="{StaticResource AlarmItem}" />
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                        <TextBlock
                            Grid.Row="1"
                            Text="{Binding Alarms.PersistenceStatusText}"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Foreground="#B45309"
                            Margin="0,8,0,0" />
                    </Grid>
                </Border>
            </Grid>
            <TextBlock
                Grid.Row="4"
                Text="{Binding PageMessage}"
                Style="{StaticResource StatusMessageTextStyle}"
                Margin="0,8,0,0" />
        </Grid>
    </Grid>
</UserControl>
