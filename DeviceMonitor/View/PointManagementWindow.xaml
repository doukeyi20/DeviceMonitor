

<!-- 点位管理：左侧选择、右侧编辑寄存器、换算和报警参数。 -->
<Window x:Class="DeviceMonitor.View.PointManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="{StaticResource ApplicationIcon}"
        xmlns:models="clr-namespace:DeviceMonitor.Model"
        Title="{Binding WindowTitle}"
        Width="1000"
        Height="700"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>

        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource AppComboBoxStyle}">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeutral}" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.75*" MinWidth="290" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="1.25*" MinWidth="370" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,14"
                Style="{StaticResource ToolbarCardStyle}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Device.Name}" FontSize="15" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DeviceEndpoint}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Text="当前不能修改配置，请先启用设备并停止采集。" Margin="0,6,0,0"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanEditConfiguration}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SectionCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="0,0,0,10">
                    <Run Text="当前设备已配置：" />
                    <Run Text="{Binding Points.Count, Mode=OneWay}" />
                    <Run Text=" 个采集点" />
                </TextBlock>
                <WrapPanel Grid.Row="1" Margin="0,0,0,4">

                    <Button Content="新增采集点" Command="{Binding NewPointCommand}"
                            Margin="0,0,8,6" Height="36"
                            Style="{StaticResource SecondaryActionButtonStyle}" />

                    <Button Content="删除选中点" Command="{Binding DeletePointCommand}"
                            Margin="0,0,8,6" Height="36"
                            Style="{StaticResource DangerActionButtonStyle}" />
                    <Button Content="刷新列表" Command="{Binding RefreshPointsCommand}"
                            Height="36" Margin="0,0,0,6"
                            Style="{StaticResource SecondaryActionButtonStyle}" />
                </WrapPanel>

                <DataGrid Grid.Row="2" MinHeight="120"
                          RowHeight="56" ColumnHeaderHeight="36"
                          ItemsSource="{Binding Points}"
                          IsEnabled="{Binding CanChoosePoint}"
                          SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                          HeadersVisibility="Column" SelectionUnit="FullRow" SelectionMode="Single"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="采集点" Width="*" MinWidth="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,6">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <TextBlock Text="{Binding RegisterTypeDescription}" FontSize="11" Margin="0,3,0,0"
                                                   Style="{StaticResource SubtleTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="地址" Binding="{Binding Address}" Width="60" />
                        <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="类型" Binding="{Binding DataType}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource SectionCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding FormTitle}" ToolTip="{Binding FormTitle}"
                           Margin="0,0,0,12" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource SectionHeadingStyle}" />

                <ScrollViewer x:Name="PointPageScroll" Grid.Row="1"
                              IsEnabled="{Binding CanEditConfiguration}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="采集点名称" Margin="0,0,0,6" FontWeight="SemiBold" />
                            <TextBox Text="{Binding PointName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="38" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <Border Style="{StaticResource ToolbarCardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="3" Text="地址与类型" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="1" Text="寄存器类型" Margin="0,0,0,6" />

                                <ComboBox Grid.Row="2" SelectedValuePath="Tag"
                                          SelectedValue="{Binding SelectedRegisterType, Mode=TwoWay}">
                                    <ComboBoxItem Content="保持寄存器（03）" Tag="{x:Static models:RegisterType.Holding}" />
                                    <ComboBoxItem Content="输入寄存器（04）" Tag="{x:Static models:RegisterType.Input}" />
                                </ComboBox>
                                <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="2">
                                    <TextBlock Text="协议地址" ToolTip="0–65535，十进制；填写协议偏移地址，不直接填 4xxxx 编号。" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="38" VerticalContentAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Row="3" Text="数据类型" Margin="0,10,0,6" />

                                <ComboBox Grid.Row="4" Grid.ColumnSpan="3" SelectedValuePath="Tag"
                                          SelectedValue="{Binding SelectedDataType, Mode=TwoWay}">
                                    <ComboBoxItem Content="UInt16 · 无符号整数" Tag="{x:Static models:PointDataType.UInt16}" />
                                    <ComboBoxItem Content="Int16 · 有符号整数" Tag="{x:Static models:PointDataType.Int16}" />
                                </ComboBox>

                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ToolbarCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="数值换算" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,10" />
                                <TextBlock Text="实际值 = 原始整数 × 倍率 + 偏移量" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="倍率" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding ScaleText, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="偏移量" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding OffsetText, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="单位（可留空）" Margin="0,10,0,6" />
                                <TextBox Text="{Binding UnitText, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Height="38" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ToolbarCardStyle}">
                            <StackPanel>
                                <TextBlock Text="报警设置" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,10" />

                                <TextBlock Text="上下限按换算后的实际值填写" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="报警下限（可留空）" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding LowerLimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="38" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="报警上限（可留空）" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding UpperLimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="38" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="撤销输入" Command="{Binding RevertPointCommand}"
                            Margin="0,0,10,0" Height="36" Style="{StaticResource SecondaryActionButtonStyle}" />

                    <Button Content="{Binding SaveButtonText}" Command="{Binding SavePointCommand}"
                            Height="36" Style="{StaticResource PrimaryActionButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding PageMessage}" Margin="0,0,16,0" VerticalAlignment="Center"
                       TextWrapping="Wrap" Style="{StaticResource StatusMessageTextStyle}" />

            <Button Grid.Column="1" Content="关闭" IsCancel="True" Width="100" Height="36"
                    Style="{StaticResource SecondaryActionButtonStyle}" />
        </Grid>
    </Grid>
</Window>
