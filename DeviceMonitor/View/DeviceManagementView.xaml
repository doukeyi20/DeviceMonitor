<!-- 设备、连接参数、点位和测试放在同一工作区，不再层层弹窗。 -->
<UserControl
    x:Class="DeviceMonitor.View.DeviceManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:view="clr-namespace:DeviceMonitor.View"
    Loaded="DeviceManagementView_Loaded"
    Unloaded="DeviceManagementView_Unloaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="220" />
            <ColumnDefinition
                Width="16" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border
            Style="{StaticResource SectionCardStyle}"
            Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                    <RowDefinition
                        Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel
                    Margin="0,0,0,12">
                    <Button
                        DockPanel.Dock="Right"
                        Content="刷新"
                        Command="{Binding RefreshDevicesCommand}"
                        Style="{StaticResource LinkActionButtonStyle}"
                        Padding="8,4" />
                    <TextBlock
                        Text="设备配置"
                        Style="{StaticResource SectionHeadingStyle}"
                        VerticalAlignment="Center" />
                </DockPanel>
                <ListBox
                    x:Name="DevicesList"
                    Grid.Row="1"
                    ItemsSource="{Binding Devices}"
                    SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                    IsSynchronizedWithCurrentItem="False"
                    IsEnabled="{Binding CanChooseDevice}"
                    BorderThickness="0"
                    Background="Transparent"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style
                            TargetType="ListBoxItem">
                            <Setter
                                Property="Margin"
                                Value="0,0,0,6" />
                            <Setter
                                Property="Padding"
                                Value="12" />
                            <Setter
                                Property="HorizontalContentAlignment"
                                Value="Stretch" />
                            <Setter
                                Property="Template">
                                <Setter.Value>
                                    <ControlTemplate
                                        TargetType="ListBoxItem">
                                        <Border
                                            x:Name="Row"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="7"
                                            BorderThickness="1"
                                            BorderBrush="Transparent"
                                            Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger
                                                Property="IsMouseOver"
                                                Value="True">
                                                <Setter
                                                    TargetName="Row"
                                                    Property="Background"
                                                    Value="{StaticResource SoftSurfaceBrush}" />
                                            </Trigger>
                                            <Trigger
                                                Property="IsSelected"
                                                Value="True">
                                                <Setter
                                                    TargetName="Row"
                                                    Property="Background"
                                                    Value="{StaticResource AccentSoftBrush}" />
                                                <Setter
                                                    TargetName="Row"
                                                    Property="BorderBrush"
                                                    Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock
                                    Text="{Binding Name}"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{Binding CommunicationText}"
                                    Margin="0,6,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock
                                    Text="{Binding Endpoint}"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel
                    Grid.Row="2"
                    Margin="0,12,0,0">
                    <Button
                        Content="新增设备配置"
                        Command="{Binding AddDeviceCommand}"
                        Height="36"
                        Style="{StaticResource PrimaryActionButtonStyle}" />
                    <Button
                        Content="删除当前设备"
                        Command="{Binding DeleteDeviceCommand}"
                        Height="34"
                        Margin="0,8,0,0"
                        Style="{StaticResource DangerActionButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border
            Grid.Column="2"
            Style="{StaticResource SectionCardStyle}"
            Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                    <RowDefinition
                        Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="{Binding ConfigurationHint}"
                    Style="{StaticResource StatusMessageTextStyle}"
                    Foreground="#B45309"
                    TextWrapping="Wrap"
                    Margin="0,0,0,8" />
                <!-- 没选设备时只显示提示，不留下可以输入却无法保存的空表单。 -->
                <StackPanel x:Name="DeviceSelectionHint" Grid.Row="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Editor}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="请选择设备" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="从左侧选择设备，或点击“新增设备配置”填写连接参数。"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
                <Grid x:Name="DeviceEditorArea" Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Editor}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TabControl
                        x:Name="ConfigurationTabs"
                        SelectedIndex="{Binding SelectedTabIndex}"
                        Background="Transparent"
                        BorderThickness="0">
                        <TabItem
                            Header="连接参数"
                            IsEnabled="{Binding CanChooseDevice}">
                            <!--对应设备编辑界面-->
                            <view:DeviceEditorView
                                DataContext="{Binding Editor}"
                                Margin="0,12,0,0" />
                        </TabItem>
                        <TabItem
                            Header="采集点与测试"
                            IsEnabled="{Binding CanOpenPoints}">
                            <!--对应点位编辑界面-->
                            <view:PointEditorView
                                DataContext="{Binding PointEditor}"
                                Margin="0,12,0,0" />
                        </TabItem>
                    </TabControl>
                </Grid>
                <TextBlock
                    Grid.Row="2"
                    Text="{Binding PageMessage}"
                    Style="{StaticResource StatusMessageTextStyle}"
                    TextWrapping="Wrap"
                    Margin="0,8,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
