

<!-- 修改或重置密码的共用表单，由 ViewModel 控制当前操作方式。 -->
<Window x:Class="DeviceMonitor.View.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="{StaticResource ApplicationIcon}"
        Title="{Binding WindowTitle}" Width="480" Height="520" MinWidth="440" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="14">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding TargetUserName}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetUserName}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,14,0,14" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <StackPanel IsEnabled="{Binding CanEditInputs}">
                    <StackPanel x:Name="CurrentPasswordPanel">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowCurrentPassword}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="原密码" />
                        <PasswordBox x:Name="OldPasswordInput" Height="36" Margin="0,5,0,12" />
                    </StackPanel>
                    <TextBlock Text="新密码（至少 6 个字符）" />
                    <PasswordBox x:Name="NewPasswordInput" Height="36" Margin="0,5,0,12" />
                    <TextBlock Text="再次输入新密码" />
                    <PasswordBox x:Name="ConfirmPasswordInput" Height="36" Margin="0,5,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding PageMessage}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Style="{StaticResource StatusMessageTextStyle}" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" IsEnabled="{Binding CanEditInputs}" Margin="0,0,10,0"
                    Style="{StaticResource SecondaryActionButtonStyle}" />
            <Button x:Name="SavePasswordButton" Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}"
                    IsDefault="True" Style="{StaticResource PrimaryActionButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
