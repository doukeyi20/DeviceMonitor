<!--
    阅读入口：DataContext 是已有 HistoryViewModel。Loaded 首次查询；切回标签保留原结果和页码。
    筛选输入只改条件，RefreshRecordsCommand 才查询；Records 每行是已保存的 HistoryRecord。
    翻页沿用上次查询；导出/趋势先到 ViewModel，再通过事件请后台选路径或开窗口。
-->
<UserControl x:Class="DeviceMonitor.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="HistoryView_Loaded" Unloaded="HistoryView_Unloaded"
             DataContextChanged="HistoryView_DataContextChanged"
             Language="zh-CN" FontFamily="Microsoft YaHei UI" Foreground="{StaticResource PrimaryTextBrush}">
    <!-- 表格自己滚动；按钮、页码不再跟着整页滚出屏幕。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}">
            <TextBlock.ToolTip>
                <StackPanel MaxWidth="380">
                    <TextBlock Text="筛选设备读数、查看点位趋势，并将查询结果导出为 CSV。" TextWrapping="Wrap" />
                    
                </StackPanel>
            </TextBlock.ToolTip>
        </TextBlock>

        <Border Grid.Row="1" Margin="0,6,0,0" Padding="6"
                Style="{StaticResource ToolbarCardStyle}">
            <Grid>
                <!-- 收起只节省地方，不清空条件；查询和重置仍常驻在右侧。 -->
                <Expander x:Name="FilterExpander" IsExpanded="False" IsEnabled="{Binding CanEditFilters}">
                    <Expander.Header>
                        <TextBlock Text="筛选条件（展开/收起）" Margin="0,3,205,3"
                                   Style="{StaticResource SectionHeadingStyle}"
                                   ToolTip="按设备、点位名称和时间筛选。折叠不会重置条件。" />
                    </Expander.Header>
                    <!-- 条件区单独滚动；最小窗口也给结果表留出表头和数据行的地方。 -->
                    <ScrollViewer MaxHeight="70" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,6,4,0">
                            <WrapPanel>
                                <StackPanel Width="210" Margin="0,0,14,8">
                                    <TextBlock Text="设备" Margin="0,0,0,5" />
                                    <ComboBox ItemsSource="{Binding DeviceOptions}" DisplayMemberPath="DisplayName"
                                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" MinHeight="32"
                                              ToolTip="来自历史数据；已删除或停用的设备仍可查询旧记录。" />
                                </StackPanel>
                                <StackPanel Width="190" Margin="0,0,0,8">
                                    <TextBlock Text="点位名称（包含，可留空）" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding PointNameFilter, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="32" MaxLength="128" />
                                </StackPanel>
                                <CheckBox Content="按时间筛选" IsChecked="{Binding UseTimeFilter}"
                                          Margin="14,23,0,8" VerticalAlignment="Center"
                                          ToolTip="勾选后按本机时间查询；不勾选则查询全部时间。" />
                            </WrapPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UseTimeFilter}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,8">
                                        <TextBlock Text="开始" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <!-- 日期从日历选择；后台 Loaded 把日期输入框设为只读。 -->
                                        <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" Width="135" MinHeight="32"
                                                    Loaded="DatePicker_Loaded" IsEnabledChanged="DatePicker_IsEnabledChanged" />
                                        <TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="86" Margin="6,0,0,0" MaxLength="8" ToolTip="HH:mm:ss，例如 08:30:00" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="结束" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="包含结束时间这一秒内的全部记录。" />
                                        <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" Width="135" MinHeight="32"
                                                    Loaded="DatePicker_Loaded" IsEnabledChanged="DatePicker_IsEnabledChanged" />
                                        <TextBox Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="86" Margin="6,0,0,0" MaxLength="8" ToolTip="HH:mm:ss，例如 17:30:00；包含结束秒内的毫秒。" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Expander>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="{Binding RefreshButtonText}" Command="{Binding RefreshRecordsCommand}"
                            Height="32" Width="105" Padding="8,4" Margin="0,0,8,0" Style="{StaticResource PrimaryActionButtonStyle}" />
                    <Button Content="重置条件" Command="{Binding ResetFiltersCommand}"
                            Height="32" Width="86" Padding="8,4" Style="{StaticResource SecondaryActionButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,4,0,4" Padding="8,3"
                Style="{StaticResource SectionCardStyle}">
            <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,10,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="查询结果" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding RecordSummary}" Style="{StaticResource SubtleTextStyle}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding RecordSummary}" VerticalAlignment="Center" />
            </Grid>
            <!-- 这组按钮操作已查询的结果；改条件后先重新查询，才允许导出和看趋势。 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="点位趋势" Command="{Binding ShowTrendCommand}"
                        ToolTip="先选中一条记录；查看该点位在本次查询范围中的最近 1000 条读数，不限当前页。"
                        Height="32" Padding="10,4" Margin="0,0,8,0" Style="{StaticResource SecondaryActionButtonStyle}" />
                <Button Content="导出全部结果" Command="{Binding ExportRecordsCommand}"
                        ToolTip="导出本次查询匹配的全部页；查询后的新增记录需重新查询后才纳入。"
                        Height="32" Padding="10,4" Style="{StaticResource SecondaryActionButtonStyle}" />
                <Button Content="取消导出" Command="{Binding ExportRecordsCancelCommand}"
                        Height="32" Padding="10,4" Margin="8,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExporting}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Padding="0" Style="{StaticResource SectionCardStyle}">
            <Grid MinHeight="70">
            <!-- 每一行是 HistoryRecord；列绑定读取这一行的属性。 -->
            <DataGrid BorderThickness="0" RowHeight="32" ColumnHeaderHeight="32" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                          CanUserResizeColumns="False" HeadersVisibility="Column"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="设备" Binding="{Binding DeviceName}" Width="2*" MinWidth="100">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding DeviceName}" />
                            </Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="采集点" Binding="{Binding PointName}" Width="2*" MinWidth="100">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding PointName}" />
                            </Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="读取值" Binding="{Binding Value}" Width="*" MinWidth="85" />
                        <DataGridTextColumn Header="读取时间（本机）" Binding="{Binding ReadAtLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}"
                                            Width="3*" MinWidth="190" />
                    </DataGrid.Columns>
                </DataGrid>
            <Border Padding="12" Margin="12,40,12,8" MaxWidth="360" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Background="{StaticResource SoftSurfaceBrush}" CornerRadius="8" IsHitTestVisible="False">
                <Border.Style><Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding ShowEmptyMessage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <StackPanel>
                    <TextBlock Text="没有匹配的历史记录" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock Text="可调整筛选条件，或连续采集成功保存后再查询。单次测试不产生历史。" Margin="0,5,0,0" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>
            </Grid>
        </Border>

        <Border Grid.Row="4" Margin="0,4,0,0" Padding="8,2" HorizontalAlignment="Left"
                Style="{StaticResource ToolbarCardStyle}">
            <StackPanel Orientation="Horizontal">
            <Button Content="上一页" Command="{Binding PreviousPageCommand}" Height="28" Padding="10,3" Margin="0,0,10,0" Style="{StaticResource SecondaryActionButtonStyle}" />
            <TextBlock Text="{Binding PageDescription}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button Content="下一页" Command="{Binding NextPageCommand}" Height="28" Padding="10,3" Style="{StaticResource SecondaryActionButtonStyle}" />
            </StackPanel>
        </Border>
        <!-- 状态一直显示；文字过长可悬停看全，不向下挤占结果表格。 -->
        <Grid Grid.Row="5" Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding FilterStatusText}" ToolTip="{Binding FilterStatusText}" TextTrimming="CharacterEllipsis"
                       FontSize="12" Margin="0,0,12,0" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding PageMessage}" ToolTip="{Binding PageMessage}" TextTrimming="CharacterEllipsis"
                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
        </Grid>
    </Grid>
</UserControl>
