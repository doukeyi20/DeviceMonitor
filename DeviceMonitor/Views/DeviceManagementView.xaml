<UserControl x:Class="DeviceMonitor.Views.DeviceManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="DeviceManagementView_Loaded"
             Unloaded="DeviceManagementView_Unloaded"
             FontFamily="Microsoft YaHei UI"
             Foreground="{StaticResource PrimaryTextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 标题 -->
            
            <RowDefinition Height="Auto" />
            <!-- 页面说明 -->
            
            <RowDefinition Height="Auto" />
            <!-- 操作按钮 -->
            
            <RowDefinition Height="Auto" />
            <!-- 连接测试结果 -->
            
            <RowDefinition Height="*" />
            <!-- 设备表格 -->
            
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="27"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="1"
                   Text="已保存的 Modbus TCP 设备配置"
                   Margin="0,7,0,0"
                   Foreground="{StaticResource SecondaryTextBrush}" />

        <!-- 按钮按顺序排列；窗口变窄时自动换行。 -->
        <WrapPanel Grid.Row="2" Margin="0,24,0,0">
            <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="0,0,20,8">
                <TextBlock Text="已保存设备：" />
                <TextBlock Text="{Binding Devices.Count}" />
                <TextBlock Text=" 台" />
            </StackPanel>

            <Button Content="新增设备"
            Width="120"
            Height="40"
            Margin="0,0,10,8"
            Click="AddDeviceButton_Click"
            Style="{StaticResource PrimaryActionButtonStyle}" />

            <Button x:Name="EditDeviceButton"
            Content="编辑选中设备"
            Width="130"
            Height="40"
            Margin="0,0,10,8"
            IsEnabled="False"
            Click="EditDeviceButton_Click"
            Style="{StaticResource SecondaryActionButtonStyle}" />

            <Button x:Name="EnableDeviceButton"
            Content="启用设备"
            Width="110"
            Height="40"
            Margin="0,0,10,8"
            IsEnabled="False"
            Click="EnableDeviceButton_Click"
            Style="{StaticResource SecondaryActionButtonStyle}" />

            <Button x:Name="DisableDeviceButton"
            Content="停用设备"
            Width="110"
            Height="40"
            Margin="0,0,10,8"
            IsEnabled="False"
            Click="DisableDeviceButton_Click"
            Style="{StaticResource SecondaryActionButtonStyle}" />

            <!-- 与其他按钮一样，通过后台点击事件取得选中的设备。 -->
            <Button x:Name="TestConnectionButton"
            Content="测试连接"
            Width="120"
            Height="40"
            Margin="0,0,0,8"
            IsEnabled="False"
            Click="TestConnectionButton_Click"
            Style="{StaticResource SecondaryActionButtonStyle}" />
        </WrapPanel>

        <!-- ViewModel 更新提示后，属性通知会让这里显示最新测试结果。 -->
        <TextBlock Grid.Row="3"
           Text="{Binding ConnectionTestMessage}"
           Margin="0,0,0,10"
           TextWrapping="Wrap"
           Foreground="{StaticResource SecondaryTextBrush}" />


        <!-- 表格只负责查看和选择设备；编辑在独立窗口中完成。 -->
        <!-- 宽窗口按比例铺开；窄窗口保留最小列宽并出现横向滚动。 -->
        <!-- ItemsSource表示表格的数据来源绑定到 ViewModel 中的设备列表。而每行绑定的就不再是viewmodel而是设备对象 -->
        <DataGrid x:Name="DevicesGrid"
          Grid.Row="4"
          ItemsSource="{Binding Devices}"
          SelectionChanged="DevicesGrid_SelectionChanged"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          CanUserReorderColumns="False"
          CanUserResizeColumns="False"
          IsReadOnly="True"
          HeadersVisibility="Column"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          MinHeight="260">
            <DataGrid.Columns>
                <DataGridTextColumn Header="编号"
                            Binding="{Binding Id}"
                            Width="*"
                            MinWidth="60" />
                <DataGridTextColumn Header="设备名称"
                            Binding="{Binding Name}"
                            Width="2*"
                            MinWidth="130" />
                <DataGridTextColumn Header="主机地址"
                            Binding="{Binding Host}"
                            Width="2*"
                            MinWidth="150" />
                <DataGridTextColumn Header="端口"
                            Binding="{Binding Port}"
                            Width="*"
                            MinWidth="65" />
                <DataGridTextColumn Header="Unit ID"
                            Binding="{Binding UnitId}"
                            Width="*"
                            MinWidth="75" />
                <DataGridTextColumn Header="采集间隔(ms)"
                            Binding="{Binding SamplingIntervalMilliseconds}"
                            Width="2*"
                            MinWidth="125" />
                <DataGridTextColumn Header="连接超时(ms)"
                            Binding="{Binding ConnectTimeoutMilliseconds}"
                            Width="2*"
                            MinWidth="125" />
                <DataGridTextColumn Header="读取超时(ms)"
                            Binding="{Binding ReadTimeoutMilliseconds}"
                            Width="2*"
                            MinWidth="125" />
                <DataGridTextColumn Header="写入超时(ms)"
                            Binding="{Binding WriteTimeoutMilliseconds}"
                            Width="2*"
                            MinWidth="125" />
                <!-- 只显示数据库中的配置，不允许直接勾选修改。 -->
                <DataGridCheckBoxColumn Header="启用状态"
                        Binding="{Binding IsEnabled, Mode=OneWay}"
                        Width="*"
                        MinWidth="90" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
