<!--
    数据源是主窗口创建的 DeviceManagementViewModel；弹窗请求由页面后台处理。
-->
<UserControl x:Class="DeviceMonitor.Views.DeviceManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="DeviceManagementView_Loaded"
             Unloaded="DeviceManagementView_Unloaded"
             DataContextChanged="DeviceManagementView_DataContextChanged"
             FontFamily="Microsoft YaHei UI"
             Foreground="{StaticResource PrimaryTextBrush}">

    <!-- 小窗口可以滚动整页，设备表也能单独左右滚动。 -->
    <ScrollViewer x:Name="DevicePageScroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Height="{Binding ViewportHeight, ElementName=DevicePageScroll}" MinHeight="470">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                <Border Grid.Column="1" Background="{StaticResource SoftSurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushNeutral}" BorderThickness="1"
                        CornerRadius="8" Padding="10,5" VerticalAlignment="Center" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="已保存设备：" Style="{StaticResource SubtleTextStyle}" />
                        <TextBlock Text="{Binding Devices.Count}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text=" 台" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Grid.Row="1" Margin="0,6,0,14" TextWrapping="Wrap"
                       Text="管理设备连接参数和采集许可；启用不会自动开始采集。"
                       Style="{StaticResource SubtleTextStyle}" />

            <!-- 按功能分组放按钮，窗口窄时自动换行。 -->
            <Border Grid.Row="2" Style="{StaticResource ToolbarCardStyle}" Margin="0,0,0,10">
                <WrapPanel>
                    <StackPanel Margin="0,0,18,6">
                        <TextBlock Text="设备配置" Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="新增设备" Width="100" Height="34" Margin="0,0,8,0"
                                    Command="{Binding AddDeviceCommand}" Style="{StaticResource PrimaryActionButtonStyle}" />
                            <Button x:Name="EditDeviceButton" Content="编辑选中设备" Width="120" Height="34"
                                    Command="{Binding EditDeviceCommand}" Style="{StaticResource SecondaryActionButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,6">
                        <TextBlock Text="采集许可" Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="EnableDeviceButton" Content="启用设备" Width="92" Height="34" Margin="0,0,8,0"
                                    Command="{Binding EnableDeviceCommand}"
                                    ToolTip="只允许这台设备被采集；不会自动启动。"
                                    Style="{StaticResource SecondaryActionButtonStyle}" />
                            <Button x:Name="DisableDeviceButton" Content="停用设备" Width="92" Height="34"
                                    Command="{Binding DisableDeviceCommand}"
                                    ToolTip="保存为停用后，任务在后续检查到停用时结束；立即请求停止请到实时监控页。"
                                    Style="{StaticResource SecondaryActionButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,6">
                        <TextBlock Text="TCP 连接" Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TestConnectionButton" Content="{Binding TestConnectionButtonText}"
                                    Width="100" Height="34" Command="{Binding TestConnectionCommand}"
                                    Style="{StaticResource SecondaryActionButtonStyle}" />
                            <Button Content="取消测试" Width="92" Height="34" Margin="8,0,0,0"
                                    Command="{Binding TestConnectionCancelCommand}"
                                    ToolTip="取消正在进行的 TCP 测试，不影响连续采集。">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTestingConnection}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,6">
                        <TextBlock Text="设备列表" Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,6" />
                        <Button Content="刷新设备" Width="100" Height="34"
                                Command="{Binding RefreshDevicesCommand}"
                                ToolTip="重新读取已保存的设备配置；不连接设备，也不启停采集。"
                                Style="{StaticResource SecondaryActionButtonStyle}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="删除配置" Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,6" />
                        <Button Content="{Binding DeleteDeviceButtonText}" Width="100" Height="34"
                                Command="{Binding DeleteDeviceCommand}"
                                ToolTip="先停止这台设备的采集，再删除设备及采集点配置；历史读数和报警历史保留。"
                                Style="{StaticResource DangerActionButtonStyle}" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- 第一行显示配置操作结果，第二行显示 TCP 测试结果。 -->
            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                <TextBlock Text="{Binding PageMessage}" TextWrapping="Wrap"
                           Style="{StaticResource SubtleTextStyle}" />
                <TextBlock Text="{Binding ConnectionTestMessage}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Style="{StaticResource SubtleTextStyle}" />
            </StackPanel>

            <!-- Devices 每项是 DeviceInfo；列绑定这一行的属性，选中项写入 SelectedDevice。 -->
            <Border Grid.Row="4" Style="{StaticResource SectionCardStyle}" Padding="0">
                <DataGrid x:Name="DevicesGrid" ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          SelectionMode="Single" SelectionUnit="FullRow" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" CanUserResizeColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" MinHeight="100"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="*" MinWidth="60" ElementStyle="{StaticResource TableCellTextStyle}" />
                        <DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="2*" MinWidth="130" ElementStyle="{StaticResource TableCellTextStyle}" />
                        <DataGridCheckBoxColumn Header="启用状态" Binding="{Binding IsEnabled, Mode=OneWay}" Width="*" MinWidth="90" />
                        <DataGridTextColumn Header="主机地址" Binding="{Binding Host}" Width="2*" MinWidth="150" ElementStyle="{StaticResource TableCellTextStyle}" />
                        <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="*" MinWidth="65" ElementStyle="{StaticResource TableCellTextStyle}" />
                        <DataGridTextColumn Header="Unit ID" Binding="{Binding UnitId}" Width="*" MinWidth="75" ElementStyle="{StaticResource TableCellTextStyle}" />
                        <DataGridTextColumn Header="采集间隔(ms)" Binding="{Binding SamplingIntervalMilliseconds}" Width="2*" MinWidth="125" ElementStyle="{StaticResource TableCellTextStyle}" />
                        <DataGridTextColumn Header="连接超时(ms)" Binding="{Binding ConnectTimeoutMilliseconds}" Width="2*" MinWidth="125" ElementStyle="{StaticResource TableCellTextStyle}" />
                        <DataGridTextColumn Header="读取超时(ms)" Binding="{Binding ReadTimeoutMilliseconds}" Width="2*" MinWidth="125" ElementStyle="{StaticResource TableCellTextStyle}" />
                        <DataGridTextColumn Header="写入超时(ms)" Binding="{Binding WriteTimeoutMilliseconds}" Width="2*" MinWidth="125" ElementStyle="{StaticResource TableCellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
