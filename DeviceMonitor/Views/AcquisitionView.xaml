<!--
    数据源是 AcquisitionViewModel；上表选设备，下表看它的点位配置，可单次测试。
-->
<UserControl x:Class="DeviceMonitor.Views.AcquisitionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DeviceMonitor.Models"
             Loaded="AcquisitionView_Loaded"
             Unloaded="AcquisitionView_Unloaded"
             DataContextChanged="AcquisitionView_DataContextChanged"
             FontFamily="Microsoft YaHei UI"
             Foreground="{StaticResource PrimaryTextBrush}">

    <!-- 先选设备，再看点位；测试按钮放在点位表旁。 -->
    <ScrollViewer x:Name="PageScrollViewer"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Height="{Binding ViewportHeight, ElementName=PageScrollViewer}" MinHeight="596">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,6">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,0,0,8" Padding="10" Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,4">
                        <TextBlock Text="设备" Style="{StaticResource SectionHeadingStyle}"
                                   VerticalAlignment="Center" Margin="0,0,18,6" />
                        <Button Content="刷新设备" Command="{Binding RefreshDevicesCommand}"
                                Height="34" Margin="0,0,10,6"
                                Style="{StaticResource SecondaryActionButtonStyle}" />
                        <!-- 命令触发开窗事件，后台 OpenPointWindow 真正显示窗口。 -->
                        <Button Content="管理采集点" Command="{Binding ManagePointsCommand}"
                                Height="34" Margin="0,0,16,6"
                                Style="{StaticResource SecondaryActionButtonStyle}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock Text="已启用：" Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock Text="{Binding Devices.Count}" FontWeight="SemiBold" />
                            <TextBlock Text=" 台" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- 每行是 DeviceInfo；选中写入 SelectedDevice，自动调用 OnSelectedDeviceChanged 加载点位。 -->
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="DevicesGrid"
                                  ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                  IsEnabled="{Binding CanChooseDevice}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False" CanUserResizeColumns="False"
                                  HeadersVisibility="Column" MinHeight="86"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="编号" Binding="{Binding Id}" Width="*" MinWidth="60" />
                                <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="设备名称" Binding="{Binding Name}" Width="2*" MinWidth="120" />
                                <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="通信方式" Binding="{Binding CommunicationText}" Width="*" MinWidth="105" />
                                <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="连接地址 / 参数" Binding="{Binding Endpoint}" Width="2*" MinWidth="180" />
                                <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="站号/Unit ID" Binding="{Binding UnitId}" Width="115" MinWidth="115" />
                                <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="采集间隔(ms)" Binding="{Binding SamplingIntervalMilliseconds}" Width="2*" MinWidth="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- 默认隐藏，Devices.Count 为 0 时显示。 -->
                        <TextBlock Text="暂无已启用设备"
                                   IsHitTestVisible="False" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="16,44,16,4" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Padding="10" Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,0,6" Style="{StaticResource SectionHeadingStyle}" TextWrapping="Wrap">
                        <Run Text="当前设备：" />
                        <Run Text="{Binding SelectedDevice.Name, Mode=OneWay, TargetNullValue=尚未选择设备, FallbackValue=尚未选择设备}" />
                        <Run Text=" · 采集点" />
                    </TextBlock>

                    <!-- 只测试选中的一个点，不连续采集、不保存历史。 -->
                    <WrapPanel Grid.Row="1">
                        <Button Content="刷新采集点" Command="{Binding RefreshPointsCommand}"
                                Height="34" Margin="0,0,10,6"
                                Style="{StaticResource SecondaryActionButtonStyle}" />
                        <Button Content="{Binding ReadOnceButtonText}" Command="{Binding ReadOnceCommand}"
                                ToolTip="只测试选中的一个点，不保存历史；同设备连续采集中不可测试。"
                                Height="34" Margin="0,0,10,6"
                                Style="{StaticResource PrimaryActionButtonStyle}" />
                        <Button Content="取消读取" Command="{Binding ReadOnceCancelCommand}"
                                Height="34" Margin="0,0,0,6"
                                Style="{StaticResource SecondaryActionButtonStyle}" />
                    </WrapPanel>

                    <!-- 本次测试的数值、状态、目标和时间分开显示；失败不沿用上次成功值。 -->
                    <Border x:Name="SingleReadResultCard" Grid.Row="2" Margin="0,0,0,8" Padding="12,10"
                            Style="{StaticResource ToolbarCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="本次读数 · 整数" Style="{StaticResource SubtleTextStyle}" FontSize="11" />
                                <TextBlock x:Name="ReadValueDisplay" Text="{Binding ReadValueText}" FontSize="32"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReadValueText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border x:Name="ReadStatusBadge" Padding="8,3" CornerRadius="5" Background="#E8ECF0">
                                        <TextBlock Text="{Binding ReadStatusText}" FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ReadState}" Value="{x:Static models:SingleReadState.Reading}"><Setter Property="Foreground" Value="#24668A" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding ReadState}" Value="{x:Static models:SingleReadState.Succeeded}"><Setter Property="Foreground" Value="#27664E" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding ReadState}" Value="{x:Static models:SingleReadState.TimedOut}"><Setter Property="Foreground" Value="#955500" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding ReadState}" Value="{x:Static models:SingleReadState.Failed}"><Setter Property="Foreground" Value="#B42318" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Style="{StaticResource SubtleTextStyle}" FontSize="11">
                                        <Run Text="读取时间  " /><Run x:Name="ReadTimeDisplay" Text="{Binding ReadTimeText, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                                <TextBlock x:Name="ReadTargetDisplay" Text="{Binding ReadTargetText}" FontSize="13"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReadTargetText}" />
                                <ScrollViewer MaxHeight="48" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                                    <TextBlock x:Name="ReadDetailsDisplay" Text="{Binding ReadResultText}" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </ScrollViewer>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ReadGuardText}" Margin="0,7,0,0"
                                       Style="{StaticResource StatusMessageTextStyle}" FontSize="11" />
                        </Grid>
                    </Border>

                    <!-- Points 每项是 PointInfo 配置；选中写入 SelectedPoint，供单次测试使用。 -->
                    <DataGrid x:Name="PointsGrid" Grid.Row="3"
                              ItemsSource="{Binding Points}"
                              SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                              IsEnabled="{Binding CanChoosePoint}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserResizeColumns="False"
                              HeadersVisibility="Column" SelectionUnit="FullRow" SelectionMode="Single"
                              MinHeight="100" ToolTip="{Binding PointMessage}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="编号" Binding="{Binding Id}" Width="*" MinWidth="60" />
                            <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="采集点名称" Binding="{Binding Name}" Width="2*" MinWidth="120" />
                            <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="寄存器类型" Binding="{Binding RegisterTypeDescription}" Width="2*" MinWidth="155" />
                            <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="协议地址" Binding="{Binding Address}" Width="*" MinWidth="85" />
                            <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="数据类型" Binding="{Binding DataTypeDescription}" Width="2*" MinWidth="170" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="4" Text="{Binding PointMessage}" Margin="0,6,0,0"
                               TextWrapping="Wrap" Style="{StaticResource StatusMessageTextStyle}" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="3" Text="{Binding PageMessage}" Margin="0,6,0,0"
                       TextWrapping="Wrap" Style="{StaticResource StatusMessageTextStyle}" />
        </Grid>
    </ScrollViewer>
</UserControl>
