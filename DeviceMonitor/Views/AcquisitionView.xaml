<UserControl x:Class="DeviceMonitor.Views.AcquisitionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="AcquisitionView_Loaded"
             FontFamily="Microsoft YaHei UI"
             Foreground="{StaticResource PrimaryTextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页面标题由对应 ViewModel 提供。 -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="27"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="1"
                   Text="选择设备，配置采集点，并管理采集任务"
                   Margin="0,7,0,0"
                   Foreground="{StaticResource SecondaryTextBrush}" />

        <WrapPanel Grid.Row="2" Margin="0,24,0,12">
            <!-- 命令从当前页面的 ViewModel 中取得，不再使用 Click。 -->
            <Button Content="刷新设备"
                    Width="120"
                    Height="40"
                    Margin="0,0,20,8"
                    Command="{Binding RefreshDevicesCommand}"
                    Style="{StaticResource SecondaryActionButtonStyle}" />

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,0,8">
                <TextBlock Text="已加载的启用设备：" />
                <TextBlock Text="{Binding Devices.Count}" />
                <TextBlock Text=" 台" />
            </StackPanel>
        </WrapPanel>

        <!-- Devices 提供列表，SelectedDevice 保存当前选择。 -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Devices}"
                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="False"
                  HeadersVisibility="Column"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  MinHeight="200">
            <DataGrid.Columns>
                <!-- 每列读取的是当前行 DeviceInfo 对象的属性。 -->
                <DataGridTextColumn Header="编号"
                                    Binding="{Binding Id}"
                                    Width="*" MinWidth="60" />
                <DataGridTextColumn Header="设备名称"
                                    Binding="{Binding Name}"
                                    Width="2*" MinWidth="120" />
                <DataGridTextColumn Header="主机地址"
                                    Binding="{Binding Host}"
                                    Width="2*" MinWidth="140" />
                <DataGridTextColumn Header="端口"
                                    Binding="{Binding Port}"
                                    Width="*" MinWidth="65" />
                <DataGridTextColumn Header="Unit ID"
                                    Binding="{Binding UnitId}"
                                    Width="*" MinWidth="75" />
                <DataGridTextColumn Header="采集间隔(ms)"
                                    Binding="{Binding SamplingIntervalMilliseconds}"
                                    Width="2*" MinWidth="120" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Margin="0,14,0,0">
            <TextBlock Text="当前选择：" />
            <TextBlock Text="{Binding SelectedDevice.Name,
                                      FallbackValue=尚未选择设备}"
                       FontWeight="SemiBold" />
        </StackPanel>

        <TextBlock Grid.Row="5"
                   Text="{Binding PageMessage}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource SecondaryTextBrush}" />
    </Grid>
</UserControl>
