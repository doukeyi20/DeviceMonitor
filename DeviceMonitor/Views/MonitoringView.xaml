<!--
    数据源是 MonitoringViewModel；左侧勾选设备，右上看读数和报警，右下看选中点位的波形。
-->
<UserControl x:Class="DeviceMonitor.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeviceMonitor.Controls"
             Loaded="MonitoringView_Loaded"
             DataContextChanged="MonitoringView_DataContextChanged"
             FontFamily="Microsoft YaHei UI"
             Foreground="{StaticResource PrimaryTextBrush}">

    <UserControl.Resources>
        <!-- 监控页面专用的表格样式。 -->
        <Style x:Key="MonitorTableStyle" TargetType="DataGrid"
               BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="RowHeight" Value="36" />
            <Setter Property="ColumnHeaderHeight" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader"
                           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="Padding" Value="6,6" />
                        <Setter Property="FontSize" Value="13" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MonitorCellTextStyle" TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="MonitorReadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MonitorCellTextStyle}">
            <Setter Property="ToolTip" Value="{Binding DetailsText}" />
        </Style>
        <!-- 行对象已经算好当前状态；报警和读取异常都用红色突出。 -->
        <Style x:Key="MonitorStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MonitorReadingTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlert}" Value="True">
                    <Setter Property="Foreground" Value="#B42318" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MonitorReadingRowStyle" TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="ToolTip" Value="{Binding DetailsText}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E7EDF2" />
                </Trigger>
                <DataTrigger Binding="{Binding IsAlert}" Value="True">
                    <Setter Property="Background" Value="#FFF1F0" />
                    <Setter Property="Foreground" Value="#B42318" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MonitorReadingCellStyle" TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <!-- 选中报警行后仍保留红色，方便一眼看出异常。 -->
                <DataTrigger Binding="{Binding IsAlert}" Value="True">
                    <Setter Property="Background" Value="#FFF1F0" />
                    <Setter Property="Foreground" Value="#B42318" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- 填满窗口高度；窗口太矮时整页可滚动，各表格也能单独滚动。 -->
    <ScrollViewer x:Name="PageScrollViewer" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Height="{Binding ViewportHeight, ElementName=PageScrollViewer}" MinHeight="650">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" Padding="12,8"
                        CornerRadius="8" Background="{StaticResource SoftSurfaceBrush}">
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="{StaticResource SecondaryTextBrush}">
                        <Run Text="已配置 " /><Run Text="{Binding Devices.Count, Mode=OneWay}" /><Run Text=" 台" />
                    </TextBlock>
                    <TextBlock Margin="0,5,0,0" FontSize="12">
                        <Run Text="正在采集 " /><Run Text="{Binding ActiveSamplingCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" 台" />
                    </TextBlock>
                </StackPanel>
                </Border>
            </Grid>

            <!-- 窗口窄时按钮自动换行。 -->
            <Border Grid.Row="1" Margin="0,12,0,10" Style="{StaticResource ToolbarCardStyle}" Padding="10,8,10,0">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                <Button Content="刷新设备" Command="{Binding RefreshDevicesCommand}"
                        Style="{StaticResource SecondaryActionButtonStyle}" Padding="12,8"
                        Width="96" Height="38" Margin="0,0,8,8" />
                <Button Content="全选" Command="{Binding CheckAllDevicesCommand}"
                        Style="{StaticResource LinkActionButtonStyle}" Padding="10,8"
                        Width="60" Height="38" Margin="0,0,8,8" />
                <Button Content="清空勾选" Command="{Binding ClearDeviceChecksCommand}"
                        ToolTip="只取消勾选，不会停止正在采集的设备。停止采集请点击“停止采集”。"
                        Style="{StaticResource LinkActionButtonStyle}" Padding="10,8"
                        Width="86" Height="38" Margin="0,0,0,8" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                <!-- 批量启停看 IsChecked 勾选，不看鼠标高亮的行。 -->
                <Button Content="开始采集" Command="{Binding StartSamplingCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}" Padding="12,8"
                        Width="100" Height="38" Margin="0,0,8,8" />
                <Button Content="停止采集" Command="{Binding StopSamplingCommand}"
                        Style="{StaticResource SecondaryActionButtonStyle}" Padding="12,8"
                        Width="100" Height="38" Margin="0,0,0,8" />
                </StackPanel>
            </WrapPanel>
            </Border>

            <!-- 左侧选设备；右上每个点位一行，右下只画选中点位。 -->
            <Grid x:Name="MonitoringWorkspace" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <!-- 设备栏收窄，把空间留给读数和波形。 -->
                    <ColumnDefinition Width="225" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="10" Style="{StaticResource SectionCardStyle}"
                        Background="{StaticResource SoftSurfaceBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="设备选择" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,10" />
                        <!-- Devices 每项是 MonitoringDeviceViewModel；IsChecked 存勾选，Device 存配置，Sampling 接采集任务。 -->
                        <DataGrid x:Name="MonitoringDevicesGrid" Grid.Row="1"
                                  ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                  Style="{StaticResource MonitorTableStyle}" RowHeight="82"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="36" MinWidth="36">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      ToolTip="勾选后参与批量启停和右侧读数汇总" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="设备 / 状态" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,7">
                                                <!-- 悬停查看这台设备的任务提示和历史保存统计。 -->
                                                <StackPanel.ToolTip>
                                                    <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <StackPanel MaxWidth="380">
                                                            <TextBlock Text="{Binding Device.Name}" FontWeight="SemiBold" />
                                                            <TextBlock Margin="0,6,0,0" Text="{Binding ConnectionDetails}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,6,0,0" Text="{Binding DataAgeText}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                                                       Text="{Binding Sampling.StatusText, TargetNullValue=尚未开始采集。, FallbackValue=尚未开始采集。}" />
                                                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                                                       Text="{Binding Sampling.HistoryStatusText, TargetNullValue=开始采集后会保存历史。, FallbackValue=开始采集后会保存历史。}" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </StackPanel.ToolTip>
                                                <TextBlock Text="{Binding Device.Name}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Text="{Binding ConnectionSummary}" ToolTip="{Binding ConnectionDetails}" />
                                                <TextBlock Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding EnabledText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SamplingStateText, Mode=OneWay}" />
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SamplingStateText}" Value="采集中">
                                                                    <Setter Property="Foreground" Value="#35705B" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.9*" MinHeight="200" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="1.1*" MinHeight="260" />
                    </Grid.RowDefinitions>

                    <Border Padding="12" Style="{StaticResource SectionCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="最新读数与报警" Style="{StaticResource SectionHeadingStyle}"
                                           ToolTip="每个点位一行，显示最新读数和当前报警；历史报警在历史记录页查看。" />
                            </DockPanel>
                            <!-- Readings 每项是一个点位的监控行；SelectedReading 决定下面画哪个点位。 -->
                            <DataGrid x:Name="MonitoringReadingsGrid" Grid.Row="1"
                                      ItemsSource="{Binding Readings}" SelectedItem="{Binding SelectedReading, Mode=TwoWay}"
                                      Style="{StaticResource MonitorTableStyle}" SelectionMode="Single" SelectionUnit="FullRow"
                                      RowStyle="{StaticResource MonitorReadingRowStyle}" CellStyle="{StaticResource MonitorReadingCellStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="设备" Binding="{Binding DeviceName}" Width="1*" MinWidth="90" ElementStyle="{StaticResource MonitorReadingTextStyle}" />
                                    <DataGridTextColumn Header="点位" Binding="{Binding PointName}" Width="1.2*" MinWidth="110" ElementStyle="{StaticResource MonitorReadingTextStyle}" />
                                    <DataGridTextColumn Header="读数" Binding="{Binding ValueText}" Width="90" MinWidth="90" ElementStyle="{StaticResource MonitorReadingTextStyle}" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="1.4*" MinWidth="130" ElementStyle="{StaticResource MonitorStatusTextStyle}" />
                                    <DataGridTextColumn Header="时间" Binding="{Binding ReadTimeText}" Width="82" MinWidth="82" ElementStyle="{StaticResource MonitorReadingTextStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="1" Text="暂无读数"
                                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18"
                                       IsHitTestVisible="False" Foreground="{StaticResource SecondaryTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Readings.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Style="{StaticResource StatusMessageTextStyle}" Grid.Row="2" Margin="0,7,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Text="{Binding DeviceRuntime.Alarms.PersistenceStatusText}"
                                       ToolTip="{Binding DeviceRuntime.Alarms.PersistenceStatusText}"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Padding="12" Style="{StaticResource SectionCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="实时波形" Style="{StaticResource SectionHeadingStyle}"
                                           VerticalAlignment="Center" ToolTip="一次只看一个点位，避免不同单位和数值范围挤在同一张图里。" />
                                <!-- 下拉框和上面的选中行是同一个 SelectedReading，不限制点位数量。 -->
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Readings}"
                                          SelectedItem="{Binding SelectedReading, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" MinWidth="180" MaxWidth="360"
                                          HorizontalAlignment="Right" Height="32" FontSize="12" Margin="16,0,0,0"
                                          ToolTip="选择设备和点位；图中显示该点位最近一段时间的读数。" />
                            </Grid>
                            <!-- Trend 保存当前选中点位的实时数据；图只负责把这些数据画出来。 -->
                            <controls:LiveTrendChart Grid.Row="1" Samples="{Binding Trend.Samples}"
                                                     AxisTitle="{Binding Trend.AxisTitle}" EndTime="{Binding Trend.EndTime}"
                                                     WindowDuration="{Binding Trend.WindowDuration}" />
                            <TextBlock Style="{StaticResource StatusMessageTextStyle}" Grid.Row="2" Margin="0,7,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Text="{Binding Trend.StatusText}" ToolTip="{Binding Trend.StatusText}"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <TextBlock Style="{StaticResource StatusMessageTextStyle}" Grid.Row="3" Margin="0,8,0,0" FontSize="11" Text="{Binding PageMessage}"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding PageMessage}"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </Grid>
    </ScrollViewer>
</UserControl>
