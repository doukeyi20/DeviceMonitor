<!--
    阅读入口：AcquisitionViewModel.CreatePointViewModel 创建数据源，后台把同一个对象交给本窗口。
    左侧 Points/SelectedPoint 是配置列表；右侧是新增或编辑的输入，不是实际读数。
    SavePointCommand → SavePoint → DeviceStore；删除确认通过事件请后台弹框。这里不读取设备寄存器。
-->
<Window x:Class="DeviceMonitor.Views.PointWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DeviceMonitor.Core.Models;assembly=DeviceMonitor.Core"
        Title="{Binding WindowTitle}"
        Width="1000"
        Height="700"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <!-- 只调整本窗口的下拉框，不改变其他页面的外观。 -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeutral}" />
        </Style>
    </Window.Resources>

    <!-- 左边选点，右边填配置。右侧表单自己滚动，保存和关闭按钮不用滚到底找。 -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" MinWidth="300" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" MinWidth="310" />
        </Grid.ColumnDefinitions>

        <!-- 当前设备由打开窗口时传入，用户不用重新选设备或填写连接地址。 -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,14"
                Style="{StaticResource ToolbarCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="采集点管理" Style="{StaticResource PageTitleStyle}"
                           VerticalAlignment="Center" Margin="0,0,24,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Device.Name}" FontSize="17" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DeviceEndpoint}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SectionCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="0,0,0,10">
                    <Run Text="当前设备已配置：" />
                    <Run Text="{Binding Points.Count, Mode=OneWay}" />
                    <Run Text=" 个采集点" />
                </TextBlock>
                <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                    <!-- 没选点位，或正在编辑时，命令的 CanExecute 会让按钮不能点击。 -->
                    <Button Content="编辑选中点" Command="{Binding BeginEditPointCommand}"
                            Margin="0,0,8,6" Height="34"
                            Style="{StaticResource SecondaryActionButtonStyle}" />
                    <!-- 删除命令先向窗口后台请求确认，确认后才会调用数据库删除方法。 -->
                    <Button Content="删除选中点" Command="{Binding DeletePointCommand}"
                            Margin="0,0,8,6" Height="34"
                            Style="{StaticResource DangerActionButtonStyle}" />
                    <Button Content="刷新列表" Command="{Binding RefreshPointsCommand}"
                            Height="34" Margin="0,0,0,6"
                            Style="{StaticResource SecondaryActionButtonStyle}" />
                </WrapPanel>

                <!-- Points 提供表格的行；SelectedItem 把选中的那一个 PointInfo 写回 SelectedPoint。
                     每列的绑定仍从当前行的 PointInfo 取属性，不是从 ViewModel 取。 -->
                <DataGrid Grid.Row="2" MinHeight="120"
                          ItemsSource="{Binding Points}"
                          SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                          HeadersVisibility="Column" SelectionUnit="FullRow" SelectionMode="Single"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="编号" Binding="{Binding Id}" Width="*" MinWidth="60" />
                        <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="采集点名称" Binding="{Binding Name}" Width="2*" MinWidth="140" />
                        <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="协议地址" Binding="{Binding Address}" Width="*" MinWidth="85" />
                        <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="寄存器类型" Binding="{Binding RegisterTypeDescription}" Width="2*" MinWidth="155" />
                        <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="数据类型" Binding="{Binding DataTypeDescription}" Width="2*" MinWidth="170" />
                        <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="报警下限" Binding="{Binding LowerLimit, TargetNullValue=未设置}" Width="*" MinWidth="95" />
                        <DataGridTextColumn ElementStyle="{StaticResource TableCellTextStyle}" Header="报警上限" Binding="{Binding UpperLimit, TargetNullValue=未设置}" Width="*" MinWidth="95" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource SectionCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- 显示固定的编辑目标；选中另一行不会偷偷改掉保存目标。 -->
                <TextBlock Text="{Binding FormTitle}" ToolTip="{Binding FormTitle}"
                           Margin="0,0,0,12" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource SectionHeadingStyle}" />

                <ScrollViewer x:Name="PointPageScroll" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <!-- 这些绑定从窗口的 PointViewModel 取值，输入立即写回对应属性。 -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="采集点名称" Margin="0,0,0,6" FontWeight="SemiBold" />
                            <TextBox Text="{Binding PointName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="38" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <Border Style="{StaticResource ToolbarCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="地址与类型" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,10" />
                                <TextBlock Text="寄存器类型" Margin="0,0,0,6" />
                                <!-- Tag 保存真实枚举值，Content 只负责显示中文。
                                     选择后，SelectedValue 把 Tag 写入 ViewModel 的属性。 -->
                                <ComboBox SelectedValuePath="Tag"
                                          SelectedValue="{Binding SelectedRegisterType, Mode=TwoWay}">
                                    <ComboBoxItem Content="保持寄存器（03）" Tag="{x:Static models:RegisterType.Holding}" />
                                    <ComboBoxItem Content="输入寄存器（04）" Tag="{x:Static models:RegisterType.Input}" />
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="协议地址" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="120" Height="38" VerticalContentAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="数据类型" Margin="0,10,0,6" />
                                <!-- 数据类型单独占一行，小窗口也能看全中文选项。 -->
                                <ComboBox SelectedValuePath="Tag"
                                          SelectedValue="{Binding SelectedDataType, Mode=TwoWay}">
                                    <ComboBoxItem Content="UInt16 · 无符号整数" Tag="{x:Static models:PointDataType.UInt16}" />
                                    <ComboBoxItem Content="Int16 · 有符号整数" Tag="{x:Static models:PointDataType.Int16}" />
                                </ComboBox>
                                <!-- 不自动猜地址：请按设备手册确认零起始协议地址。 -->
                                <TextBlock Margin="0,10,0,0"
                                           Text="协议地址填写 0–65535 的十进制整数，以设备手册为准；不要直接套用 4xxxx 编号。本阶段每个采集点读取一个 16 位寄存器。"
                                           TextWrapping="Wrap" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ToolbarCardStyle}">
                            <StackPanel>
                                <TextBlock Text="报警设置" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,10" />
                                <!-- 输入写回 PointViewModel；保存命令会检查整数范围和上下限的大小。 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="报警下限（可留空）" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding LowerLimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="38" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="报警上限（可留空）" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding UpperLimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="38" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,10,0,0"
                                           Text="留空不判断这一侧；两侧都留空，不做数值报警。只有连续采集读到有效值才判断上下限，单次测试不产生报警。"
                                           TextWrapping="Wrap" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="取消编辑" Command="{Binding CancelEditPointCommand}"
                            Margin="0,0,10,0" Height="36">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryActionButtonStyle}">
                                <Style.Triggers>
                                    <!-- 新增时不用取消编辑按钮；进入编辑模式后才显示。 -->
                                    <DataTrigger Binding="{Binding IsEditing}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- 新增与编辑共用表单和保存命令，由 ViewModel 决定插入还是修改。 -->
                    <Button Content="{Binding SaveButtonText}" Command="{Binding SavePointCommand}"
                            Height="36" Style="{StaticResource PrimaryActionButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 此窗口只配置点位。真正读取和结果显示已经放到采集管理主页面。 -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- 校验、保存、刷新结果都由 ViewModel 修改这条提示。 -->
            <TextBlock Text="{Binding PageMessage}" Margin="0,0,16,0" VerticalAlignment="Center"
                       TextWrapping="Wrap" Style="{StaticResource SubtleTextStyle}" />
            <!-- ShowDialog 打开的窗口可用 IsCancel 关闭，点击或按 Esc 都可以。 -->
            <Button Grid.Column="1" Content="关闭" IsCancel="True" Width="100" Height="36"
                    Style="{StaticResource SecondaryActionButtonStyle}" />
        </Grid>
    </Grid>
</Window>
