<Window x:Class="DeviceMonitor.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 - DeviceMonitor"
        Width="500"
        Height="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="14"
        Foreground="{StaticResource PrimaryTextBrush}">

    <Border Margin="22"
            Padding="28"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushNeutral}"
            BorderThickness="1"
            CornerRadius="14">

        <!-- 两套表单占同一个位置，每次只显示其中一套 -->
        <Grid>

            <!-- 登录表单 -->
            <StackPanel x:Name="LoginPanel"
                        VerticalAlignment="Center">
                <TextBlock Text="设备监控系统"
                           FontSize="27"
                           FontWeight="SemiBold" />

                <TextBlock Text="请使用账户登录"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,7,0,30" />

                <TextBlock Text="用户名" FontWeight="SemiBold" />
                <TextBox x:Name="UserNameInput"
                         Height="40"
                         Margin="0,7,0,18" />

                <TextBlock Text="密码" FontWeight="SemiBold" />
                <PasswordBox x:Name="PasswordInput"
                             Height="40"
                             Margin="0,7,0,24" />

                <Button x:Name="LoginButton"
                        Click="LoginButton_Click"
                        Content="登录"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Height="42" />

                <!-- 只有数据库中没有用户时，后续才会显示这个入口 -->
                <Button x:Name="FirstAdminButton"
                        Content="首次使用？创建管理员账号"
                        Click="FirstAdminButton_Click"
                        Visibility="Collapsed"
                        Style="{StaticResource LinkActionButtonStyle}"
                        Margin="0,14,0,0" />
            </StackPanel>

            <!-- 首次创建管理员表单 -->
            <StackPanel x:Name="AdminSetupPanel"
                        Visibility="Collapsed"
                        VerticalAlignment="Center">
                <TextBlock Text="创建首个管理员"
                           FontSize="27"
                           FontWeight="SemiBold" />

                <TextBlock Text="仅首次使用时需要创建"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,7,0,22" />

                <TextBlock Text="用户名" FontWeight="SemiBold" />
                <TextBox x:Name="AdminUserNameInput"
                         Height="40"
                         Margin="0,7,0,14" />

                <TextBlock Text="密码" FontWeight="SemiBold" />
                <PasswordBox x:Name="AdminPasswordInput"
                             Height="40"
                             Margin="0,7,0,14" />

                <TextBlock Text="确认密码" FontWeight="SemiBold" />
                <PasswordBox x:Name="ConfirmPasswordInput"
                             Height="40"
                             Margin="0,7,0,22" />

                <Button x:Name="CreateAdminButton"
                        Click="CreateAdminButton_Click"
                        Content="创建管理员"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Height="42" />

                <Button Content="返回登录"
                        Click="BackToLoginButton_Click"
                        Style="{StaticResource LinkActionButtonStyle}"
                        Margin="0,10,0,0" />
            </StackPanel>

        </Grid>
    </Border>
</Window>
