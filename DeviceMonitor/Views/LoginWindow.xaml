

<!-- 登录与首次管理员创建；密码由窗口事件按需读取。 -->
<Window x:Class="DeviceMonitor.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 - DeviceMonitor"
        Icon="{StaticResource ApplicationIcon}"
        Width="500"
        Height="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="14"
        Foreground="{StaticResource PrimaryTextBrush}">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Border Margin="22" Padding="28" CornerRadius="14" IsEnabled="{Binding CanEdit}"
            Style="{StaticResource SectionCardStyle}">
        <Border.Effect>
            <DropShadowEffect Color="#222A32" BlurRadius="18" ShadowDepth="2" Opacity="0.07" />
        </Border.Effect>

        <Grid>

            <StackPanel x:Name="LoginPanel"
                        Visibility="{Binding IsLoginVisible, Converter={StaticResource BooleanToVisibility}}"
                        VerticalAlignment="Center">

                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{StaticResource SoftSurfaceBrush}" CornerRadius="12">
                        <TextBlock Text="DM" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="设备监控系统" Style="{StaticResource PageTitleStyle}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="用户名" FontWeight="SemiBold" />
                <TextBox x:Name="UserNameInput"
                         Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="40"
                         Margin="0,7,0,18" />

                <TextBlock Text="密码" FontWeight="SemiBold" />
                <PasswordBox x:Name="PasswordInput"
                             Height="40"
                             Margin="0,7,0,24" />

                <Button x:Name="LoginButton"
                        Command="{Binding LoginCommand}"
                        Content="登录"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Height="42" />

                <Button x:Name="FirstAdminButton"
                        Content="首次使用？创建管理员账号"
                        Command="{Binding ShowAdminSetupCommand}"
                        Visibility="{Binding CanCreateFirstAdministrator, Converter={StaticResource BooleanToVisibility}}"
                        Style="{StaticResource LinkActionButtonStyle}"
                        Margin="0,14,0,0" />
            </StackPanel>

            <StackPanel x:Name="AdminSetupPanel"
                        Visibility="{Binding IsAdminSetupVisible, Converter={StaticResource BooleanToVisibility}}"
                        VerticalAlignment="Center">

                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{StaticResource SoftSurfaceBrush}" CornerRadius="12">
                        <TextBlock Text="DM" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="创建首个管理员" Style="{StaticResource PageTitleStyle}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="用户名" FontWeight="SemiBold" />
                <TextBox x:Name="AdminUserNameInput"
                         Text="{Binding AdminUserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="40"
                         Margin="0,7,0,14" />

                <TextBlock Text="密码" FontWeight="SemiBold" />
                <PasswordBox x:Name="AdminPasswordInput"
                             Height="40"
                             Margin="0,7,0,14" />

                <TextBlock Text="确认密码" FontWeight="SemiBold" />
                <PasswordBox x:Name="ConfirmPasswordInput"
                             Height="40"
                             Margin="0,7,0,22" />

                <Button x:Name="CreateAdminButton"
                        Command="{Binding CreateFirstAdminCommand}"
                        Content="创建管理员"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Height="42" />

                <Button x:Name="BackToLoginButton" Content="返回登录"
                        Command="{Binding BackToLoginCommand}"
                        Style="{StaticResource LinkActionButtonStyle}"
                        Margin="0,10,0,0" />
            </StackPanel>

        </Grid>
    </Border>
    </ScrollViewer>
</Window>
