<Window x:Class="DeviceMonitor.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 - DeviceMonitor"
        Width="460"
        Height="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F7">

    <Border Margin="16"
            Padding="12"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="12">

        <!-- 两套表单占同一个位置，每次只显示其中一套 -->
        <Grid>

            <!-- 登录表单 -->
            <StackPanel x:Name="LoginPanel">
                <TextBlock Text="设备监控系统"
                           FontSize="24"
                           FontWeight="SemiBold" />

                <TextBlock Text="请登录"
                           Foreground="#6B7280"
                           Margin="0,6,0,28" />

                <TextBlock Text="用户名" />
                <TextBox x:Name="UserNameInput"
                         Height="34"
                         Margin="0,5,0,16" />

                <TextBlock Text="密码" />
                <PasswordBox x:Name="PasswordInput"
                             Height="34"
                             Margin="0,5,0,22" />

                <Button x:Name="LoginButton"
                        Click="LoginButton_Click"
                        Content="登录"
                        Height="38" />

                <!-- 只有数据库中没有用户时，后续才会显示这个入口 -->
                <Button x:Name="FirstAdminButton"
                        Content="首次使用？创建管理员账号"
                        Click="FirstAdminButton_Click"
                        Visibility="Collapsed"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#2563EB"
                        Margin="0,16,0,0" />
            </StackPanel>

            <!-- 首次创建管理员表单 -->
            <StackPanel x:Name="AdminSetupPanel"
                        Visibility="Collapsed">
                <TextBlock Text="创建首个管理员"
                           FontSize="24"
                           FontWeight="SemiBold" />

                <TextBlock Text="仅首次使用时需要创建"
                           Foreground="#6B7280"
                           Margin="0,6,0,20" />

                <TextBlock Text="用户名" />
                <TextBox x:Name="AdminUserNameInput"
                         Height="34"
                         Margin="0,5,0,12" />

                <TextBlock Text="密码" />
                <PasswordBox x:Name="AdminPasswordInput"
                             Height="34"
                             Margin="0,5,0,12" />

                <TextBlock Text="确认密码" />
                <PasswordBox x:Name="ConfirmPasswordInput"
                             Height="34"
                             Margin="0,5,0,18" />

                <Button x:Name="CreateAdminButton"
                        Click="CreateAdminButton_Click"
                        Content="创建管理员"
                        Height="38" />

                <Button Content="返回登录"
                        Click="BackToLoginButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#2563EB"
                        Margin="0,10,0,0" />
            </StackPanel>

        </Grid>
    </Border>
</Window>