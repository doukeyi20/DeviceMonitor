<UserControl x:Class="DeviceMonitor.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="400"
                    HorizontalAlignment="Left">

            <TextBlock Text="{Binding Title}"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="创建操作员账户"
                       Margin="0,8,0,18"
                       Foreground="#6B7280" />

            <TextBlock Text="用户名" />
            <TextBox x:Name="NewUserNameInput"
                     Height="34"
                     Margin="0,6,0,16" />

            <TextBlock Text="初始密码" />
            <PasswordBox x:Name="NewPasswordInput"
                         Height="34"
                         Margin="0,6,0,16" />

            <TextBlock Text="确认密码" />
            <PasswordBox x:Name="ConfirmPasswordInput"
                         Height="34"
                         Margin="0,6,0,20" />

            <Button x:Name="CreateOperatorButton"
                    Content="创建操作员"
                    Height="38"
                    Click="CreateOperatorButton_Click" />
            
            <TextBlock Text="已有账户"
           Margin="0,24,0,8"
           FontSize="18"
           FontWeight="SemiBold" />

            <DataGrid x:Name="UsersGrid"
          ItemsSource="{Binding Users}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsReadOnly="True"
          SelectionChanged="UsersGrid_SelectionChanged"
          Height="240">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="用户名"
                            Binding="{Binding UserName}"
                            Width="*" />
                    <DataGridTextColumn Header="角色"
                            Binding="{Binding Role}"
                            Width="110" />
                    <DataGridCheckBoxColumn Header="已启用"
                                Binding="{Binding IsEnabled, Mode=OneWay}"
                                Width="80" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 先在表格中选择操作员，再执行明确的启用或停用操作。 -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="EnableOperatorButton"
                        Content="启用选中操作员"
                        Width="180"
                        Height="34"
                        IsEnabled="False"
                        Click="EnableOperatorButton_Click" />

                <Button x:Name="DisableOperatorButton"
                        Content="停用选中操作员"
                        Width="180"
                        Height="34"
                        Margin="12,0,0,0"
                        IsEnabled="False"
                        Click="DisableOperatorButton_Click" />
            </StackPanel>


        </StackPanel>
    </ScrollViewer>
</UserControl>
