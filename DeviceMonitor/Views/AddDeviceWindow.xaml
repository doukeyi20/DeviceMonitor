<Window x:Class="DeviceMonitor.Views.AddDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增设备"
        Width="700"
        Height="600"
        MinWidth="600"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        Foreground="{StaticResource PrimaryTextBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="新增 Modbus TCP 设备"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Text="按设备实际参数填写；所有字段都需要输入。"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>

        <!-- 窗口变矮时只滚动表单，底部按钮仍留在原位。 -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,18,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Padding="20"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushNeutral}"
                    BorderThickness="1"
                    CornerRadius="10">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock Text="设备名称" />
                        <TextBox x:Name="DeviceNameInput"
                                 Height="40"
                                 Margin="0,7,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock Text="主机地址 / IP" />
                        <TextBox x:Name="HostInput"
                                 Height="40"
                                 Margin="0,7,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock Text="TCP 端口" />
                        <TextBox x:Name="PortInput"
                                 Height="40"
                                 Margin="0,7,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock Text="Unit ID" />
                        <TextBox x:Name="UnitIdInput"
                                 Height="40"
                                 Margin="0,7,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock Text="采集间隔（毫秒）" />
                        <TextBox x:Name="SamplingIntervalInput"
                                 Height="40"
                                 Margin="0,7,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock Text="连接超时（毫秒）" />
                        <TextBox x:Name="ConnectTimeoutInput"
                                 Height="40"
                                 Margin="0,7,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0">
                        <TextBlock Text="读取超时（毫秒）" />
                        <TextBox x:Name="ReadTimeoutInput"
                                 Height="40"
                                 Margin="0,7,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="2">
                        <TextBlock Text="写入超时（毫秒）" />
                        <TextBox x:Name="WriteTimeoutInput"
                                 Height="40"
                                 Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="取消"
                    Width="90"
                    Height="40"
                    IsCancel="True"
                    Style="{StaticResource SecondaryActionButtonStyle}" />

            <Button x:Name="SaveDeviceButton"
                    Content="保存设备"
                    Width="120"
                    Height="40"
                    Margin="12,0,0,0"
                    Click="SaveDeviceButton_Click"
                    Style="{StaticResource PrimaryActionButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>